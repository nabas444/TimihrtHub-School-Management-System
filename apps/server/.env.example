# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/timhirthub

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── Email (Nodemailer / Resend) ──────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
EMAIL_FROM=noreply@timhirthub.com

# ─── File Storage ─────────────────────────────────────────
# Use Cloudinary if you want remote file hosting.
# Leave CLOUDINARY_URL empty to keep uploads local during development.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=timhirthub

# Optional legacy AWS settings — leave empty if not using AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── SMS (Africa's Talking) ────────────────────────────────
# Phase 5: parent absence/fee alerts, opt-in per parent (User.smsOptIn).
# Leave unset to run with SMS disabled — sendSms() no-ops safely if these
# are missing, so nothing else breaks without them configured.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENV=sandbox

# ─── Misc ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
APP_NAME=TimhirtHub
