// ─────────────────────────────────────────────────────────────────────────────
// TimhirtHub — Full Prisma Schema
// TimhirtHub Platform: Students · Teachers · Parents · Admins
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
