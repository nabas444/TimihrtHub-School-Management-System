// ─────────────────────────────────────────────────────────────────────────────
// SCHOOL (Tenant root — every record belongs to a school)
// ─────────────────────────────────────────────────────────────────────────────

model School {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique // used in subdomain routing
  logo          String?
  address       String?
  city          String?
  country       String   @default("Ethiopia")
  phone         String?
  email         String?
  website       String?
  timezone      String   @default("Africa/Addis_Ababa")
  academicYear  String   @default("2024/2025")
  termSystem    String   @default("SEMESTER") // SEMESTER | TRIMESTER | QUARTER
  gradingSystem String   @default("PERCENTAGE") // PERCENTAGE | GPA | LETTER
  maxStudents   Int      @default(500)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscription  Subscription?
  users         User[]
  classes       Class[]
  subjects      Subject[]
  academicTerms AcademicTerm[]
  announcements Announcement[]
  chatRooms     ChatRoom[]
  feeTemplates  FeeTemplate[]
  feeInvoices   FeeInvoice[]
  libraryBooks  LibraryBook[]
  events        SchoolEvent[]
  files         File[]
  notifications Notification[]
  gradeLevels   GradeLevel[]
  busRoutes     BusRoute[]
  settings      SchoolSettings?
  lookupValues  LookupValue[]
  certificates  Certificate[]
  annualPlans   AnnualPlan[]
  supportPrograms SupportProgram[]
  tutorialSessions TutorialSession[]
  externalExamCheckpoints ExternalExamCheckpoint[]
  ceremonyEvents CeremonyEvent[]

  // HR & Recruiting
  employees             Employee[]
  jobRequisitions       JobRequisition[]
  jobPostings           JobPosting[]
  jobApplications       JobApplication[]
  jobInterviews         JobInterview[]
  jobOffers             JobOffer[]
  onboardingChecklists  OnboardingChecklist[]
  employeeDocuments     EmployeeDocument[]
  performanceReviews    PerformanceReview[]
  staffTrainings        StaffTraining[]
  staffDisciplinaryRecords StaffDisciplinaryRecord[]
  offboardingRecords    OffboardingRecord[]

  // Curriculum & Policies
  curriculumStandards   CurriculumStandard[]
  curriculumUnits       CurriculumUnit[]
  policies              Policy[]
  policyVersions        PolicyVersion[]
  policyAcknowledgments PolicyAcknowledgment[]

  // Admissions
  applicants            Applicant[]

  // Audit Logs
  auditLogs             AuditLog[]

  // Hostel / Dormitory
  hostels               Hostel[]
  hostelApplications    HostelApplication[]

  // Inventory & Asset Management
  inventoryLocations   InventoryLocation[]
  inventoryCategories  InventoryCategory[]
  inventorySuppliers   Supplier[]
  inventoryItems       InventoryItem[]
  inventoryRequests    InventoryRequest[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  inventoryAllocations InventoryAllocation[]
  inventoryMovements   InventoryMovement[]
  maintenanceRecords   MaintenanceRecord[]
  disposalRecords      DisposalRecord[]
  stockCounts          StockCount[]

  @@map("schools")
}

model SchoolSettings {
  id                   String  @id @default(uuid())
  schoolId             String  @unique
  allowParentChat      Boolean @default(true)
  allowStudentChat     Boolean @default(true)
  attendanceStartTime  String  @default("08:00")
  attendanceCutoffTime String  @default("09:00")
  lateThresholdMinutes Int     @default(15)
  passMarkPercentage   Int     @default(50)
  enableAiFeatures     Boolean @default(true)
  enableLibrary        Boolean @default(true)
  enableTransport      Boolean @default(false)
  primaryColor         String  @default("#4F46E5")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTION & BILLING
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid())
  schoolId             String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String    @id @default(uuid())
  subscriptionId  String
  amount          Float
  currency        String    @default("USD")
  status          String // succeeded | failed | pending
  stripePaymentId String?   @unique
  invoiceUrl      String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS (all 4 roles in one table, role-specific profiles separate)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  schoolId         String
  role             Role
  email            String
  password         String?
  googleId         String?       @unique
  authProvider     AuthProvider  @default(LOCAL)
  firstName        String
  middleName       String?
  lastName         String
  phone            String?
  avatar           String?
  gender           Gender?
  dateOfBirth      DateTime?
  address          String?
  nationality      String?
  city             String?
  state            String?
  pincode          String?
  birthPlace       String?
  emergencyContact String?
  emergencyPhone   String?
  isActive         Boolean   @default(true)
  isEmailVerified  Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Phase 5 (SMS Notification Channel): opt-in, not on by default, so a
  // parent must explicitly choose to receive absence/fee-due alerts by SMS
  // in addition to the existing in-app/push notifications.
  smsOptIn Boolean @default(false)

  // Auth tokens
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  // Role-specific profiles
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
  adminProfile   AdminProfile?

  // Academic
  createdAssignments Assignment[]       @relation("AssignmentCreator")
  submissions        Submission[]       @relation("StudentSubmissions")
  gradedSubmissions  Submission[]       @relation("GradedBy")
  attendanceRecords  AttendanceRecord[] @relation("StudentAttendance")
  markedAttendance   AttendanceRecord[] @relation("TeacherAttendance")
  behaviourRecords   BehaviourRecord[]  @relation("StudentBehaviour")
  behaviourReports   BehaviourRecord[]  @relation("TeacherReports")

  // Communication
  sentMessages      Message[]      @relation("MessageSender")
  notifications     Notification[]
  announcements     Announcement[] @relation("AnnouncementAuthor")
  meetingsAsTeacher Meeting[]      @relation("TeacherMeetings")
  meetingsAsParent  Meeting[]      @relation("ParentMeetings")
  uploadedFiles     File[]

  // Certificates
  receivedCertificates Certificate[] @relation("CertificateRecipient")
  signedCertificates   Certificate[] @relation("CertificateSigner")

  // Annual Plans
  createdAnnualPlans  AnnualPlan[] @relation("AnnualPlanCreator")
  reviewedAnnualPlans AnnualPlan[] @relation("AnnualPlanReviewer")

  // Student Support
  approvedSupportEnrollments StudentSupportEnrollment[] @relation("SupportEnrollmentApprover")

  // External Exam Records
  externalExamRecordsRecorded ExternalExamRecord[] @relation("ExternalExamRecorder")

  // HR & Recruiting
  employeeProfile             Employee?
  requestedRequisitions       JobRequisition[]      @relation("RequisitionRequester")
  approvedRequisitions        JobRequisition[]      @relation("RequisitionApprover")
  interviews                  JobInterview[]        @relation("InterviewInterviewer")
  interviewFeedbacks          InterviewFeedback[]   @relation("FeedbackInterviewer")
  performanceReviewsAuthored  PerformanceReview[]   @relation("PerformanceReviewer")

  // Curriculum & Policies
  createdCurriculumUnits        CurriculumUnit[]        @relation("CurriculumUnitCreator")
  reviewedCurriculumUnits       CurriculumUnit[]        @relation("CurriculumUnitReviewer")
  createdCurriculumUnitVersions CurriculumUnitVersion[] @relation("CurriculumUnitVersionCreator")
  ownedPolicies                 Policy[]                @relation("PolicyOwner")
  createdPolicies               Policy[]                @relation("PolicyCreator")
  createdPolicyVersions         PolicyVersion[]         @relation("PolicyVersionCreator")
  reviewedPolicyVersions        PolicyVersion[]         @relation("PolicyVersionReviewer")
  policyAcknowledgments         PolicyAcknowledgment[]

  // Hostel / Dormitory
  reviewedHostelApplications    HostelApplication[]       @relation("HostelApplicationReviewer")
  allocatedHostelAllocations    HostelAllocation[]        @relation("HostelAllocator")
  decidedHostelTransfers        HostelTransferRequest[]   @relation("TransferDecider")
  markedNightAttendances        HostelNightAttendance[]   @relation("NightAttendanceMarker")
  approvedHostelOutpasses       HostelOutpass[]           @relation("OutpassApprover")
  loggedHostelVisitors          HostelVisitorLog[]        @relation("VisitorLogger")
  reportedHostelTickets         HostelMaintenanceTicket[] @relation("TicketReporter")
  reportedHostelIncidents       HostelIncidentReport[]    @relation("IncidentReporter")

  // Inventory & Asset Management
  inventoryRequestsMade       InventoryRequest[]      @relation("RequestedBy")
  inventoryRequestsApproved   InventoryRequest[]      @relation("ApprovedRequests")
  custodianAllocations        InventoryAllocation[]   @relation("CustodianOf")
  allocationsIssued           InventoryAllocation[]   @relation("IssuedAllocations")
  purchaseOrdersMade          PurchaseOrder[]         @relation("OrderedPOs")
  purchaseOrdersApproved      PurchaseOrder[]         @relation("ApprovedPOs")
  goodsReceiptsRecorded       GoodsReceipt[]
  inventoryMovementsPerformed InventoryMovement[]
  maintenanceReported         MaintenanceRecord[]     @relation("ReportedMaintenance")
  maintenanceAssigned         MaintenanceRecord[]     @relation("AssignedMaintenance")
  disposalsApproved           DisposalRecord[]
  stockCountsStarted          StockCount[]

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, email])
  @@index([schoolId, role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLE PROFILES
// ─────────────────────────────────────────────────────────────────────────────

model StudentProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  admissionNumber   String
  rollNumber        String?
  classId           String?
  gradeLevelId      String?
  bloodGroup        String?
  medicalNotes      String?
  enrolledAt        DateTime      @default(now())
  graduatedAt       DateTime?
  busRouteId        String?
  usesTransport     Boolean?
  programType       ProgramType?
  programTypeLabel  String?
  status            StudentStatus @default(ACTIVE)

  middleName        String?
  fatherFirstName   String?
  fatherMiddleName  String?
  fatherLastName    String?
  motherFirstName   String?
  motherMiddleName  String?
  motherLastName    String?
  fatherMobile      String?
  fatherPhoto       String?
  motherMobile      String?
  motherPhoto       String?
  landline          String?
  nationality       String?
  city              String?
  state             String?
  pincode           String?
  birthPlace        String?
  religionId        String?
  categoryId        String?
  feeCategoryId     String?
  sourceId          String?
  houseId           String?
  curriculumId      String?
  previousSchoolId  String?
  previousClassYear String?
  reference         String?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  class             Class?              @relation(fields: [classId], references: [id])
  gradeLevel        GradeLevel?         @relation(fields: [gradeLevelId], references: [id])
  parentLinks       ParentStudentLink[]
  busRoute          BusRoute?           @relation(fields: [busRouteId], references: [id])
  feeInvoices       FeeInvoice[]
  libraryIssues     LibraryIssue[]
  aiInsights        AiInsight[]
  ExamResult        ExamResult[]
  GradeReport       GradeReport[]

  religion          LookupValue?        @relation("StudentReligion", fields: [religionId], references: [id])
  category          LookupValue?        @relation("StudentCategory", fields: [categoryId], references: [id])
  feeCategory       LookupValue?        @relation("StudentFeeCategory", fields: [feeCategoryId], references: [id])
  source            LookupValue?        @relation("StudentSource", fields: [sourceId], references: [id])
  house             LookupValue?        @relation("StudentHouse", fields: [houseId], references: [id])
  curriculum        LookupValue?        @relation("StudentCurriculum", fields: [curriculumId], references: [id])
  previousSchool    LookupValue?        @relation("StudentPreviousSchool", fields: [previousSchoolId], references: [id])

  installmentPlans      InstallmentPlan[]
  academicYearSummaries AcademicYearSummary[]
  certificates          Certificate[]
  supportEnrollments    StudentSupportEnrollment[]
  tutorialEnrollments   TutorialEnrollment[]
  externalExamRecords   ExternalExamRecord[]
  ceremonyParticipants  CeremonyParticipant[]

  // Hostel / Dormitory
  hostelApplications     HostelApplication[]
  hostelAllocations      HostelAllocation[]
  hostelTransferRequests HostelTransferRequest[]
  hostelVisitorLogs      HostelVisitorLog[]

  @@map("student_profiles")
}

model TeacherProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  employeeId       String
  qualification    String?
  specialization   String?
  designation      String?
  experienceYears  Int?
  joinedAt         DateTime @default(now())
  isClassTeacher   Boolean  @default(false)
  classTeacherOfId String?
  gradeLevelId     String?
  religionId       String?
  houseId          String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Single class this teacher is class-teacher of
  classTeacherOf   Class?            @relation("ClassTeacher", fields: [classTeacherOfId], references: [id])
  // Classes this teacher has been assigned to (many-to-many)
  assignedClasses  Class[]           @relation("AssignedClasses")
  gradeLevel       GradeLevel?       @relation("TeacherGradeLevel", fields: [gradeLevelId], references: [id])
  subjectTeachings SubjectTeaching[]
  leaveRequests    LeaveRequest[]
  payrollRecords   PayrollRecord[]
  annualPlans      AnnualPlan[]
  tutorialSessions TutorialSession[]
  curriculumUnits  CurriculumUnit[]

  religion         LookupValue?      @relation("TeacherReligion", fields: [religionId], references: [id])
  house            LookupValue?      @relation("TeacherHouse", fields: [houseId], references: [id])

  @@map("teacher_profiles")
}

model ParentProfile {
  id           String              @id @default(uuid())
  userId       String              @unique
  occupation   String?
  relation     String? // Father | Mother | Guardian
  annualIncome String?
  education    String?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks ParentStudentLink[]

  @@map("parent_profiles")
}

model AdminProfile {
  id           String       @id @default(uuid())
  userId       String       @unique
  employeeId   String?
  department   String?
  designation  String?
  joinedAt     DateTime     @default(now())
  isSuperAdmin Boolean      @default(false)
  religionId   String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  religion     LookupValue? @relation("AdminReligion", fields: [religionId], references: [id])

  @@map("admin_profiles")
}

model ParentStudentLink {
  id               String   @id @default(uuid())
  parentProfileId  String
  studentProfileId String
  relation         String   @default("Guardian")
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  parentProfile  ParentProfile  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([parentProfileId, studentProfileId])
  @@map("parent_student_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model GradeLevel {
  id            String        @id @default(uuid())
  schoolId      String
  name          String // Grade 1, Grade 10, Form 3, etc.
  level         Int // numeric order
  milestoneType MilestoneType @default(NONE)
  createdAt     DateTime      @default(now())

  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes                 Class[]
  subjects                Subject[]
  students                StudentProfile[]
  exams                   Exam[]
  teachers                TeacherProfile[]         @relation("TeacherGradeLevel")
  announcements           Announcement[]
  tutorialSessions        TutorialSession[]
  externalExamCheckpoints ExternalExamCheckpoint[]
  ceremonyEvents          CeremonyEvent[]
  curriculumStandards     CurriculumStandard[]
  curriculumUnits         CurriculumUnit[]

  @@unique([schoolId, level])
  @@map("grade_levels")
}

model Class {
  id               String      @id @default(uuid())
  schoolId         String
  gradeLevelId     String
  name             String // 10A, 10B, Form 3 Science, etc.
  academicYear     String
  capacity         Int         @default(40)
  room             String?
  programType      ProgramType @default(REGULAR)
  programTypeLabel String?
  createdAt        DateTime    @default(now())

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel        GradeLevel         @relation(fields: [gradeLevelId], references: [id])
  students          StudentProfile[]
  classTeacher      TeacherProfile[]   @relation("ClassTeacher")
  // Teachers assigned to this class (many-to-many)
  assignedTeachers  TeacherProfile[]   @relation("AssignedClasses")
  teachings         SubjectTeaching[]
  timetableSlots    TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  announcements     Announcement[]
  chatRoom          ChatRoom?          @relation("ClassChatRoom")
  exams             Exam[]
  tutorialSessions  TutorialSession[]

  @@unique([schoolId, name, academicYear])
  @@map("classes")
}

model AcademicTerm {
  id           String   @id @default(uuid())
  schoolId     String
  name         String // Semester 1, Term 2, Q1
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  exams             Exam[]
  attendanceRecords AttendanceRecord[]
  gradeReports      GradeReport[]

  @@map("academic_terms")
}

model Subject {
  id           String   @id @default(uuid())
  schoolId     String
  gradeLevelId String?
  name         String
  code         String
  description  String?
  creditHours  Int      @default(3)
  isCore       Boolean  @default(true)
  createdAt    DateTime @default(now())

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel       GradeLevel?       @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  teachings        SubjectTeaching[]
  assignments      Assignment[]
  exams            Exam[]
  annualPlans      AnnualPlan[]
  tutorialSessions TutorialSession[]
  curriculumStandards CurriculumStandard[]
  curriculumUnits  CurriculumUnit[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model SubjectTeaching {
  id               String @id @default(uuid())
  classId          String
  subjectId        String
  teacherProfileId String
  academicYear     String

  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile  @relation(fields: [teacherProfileId], references: [id])
  timetableSlots TimetableSlot[]

  @@unique([classId, subjectId, academicYear])
  @@map("subject_teachings")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────────

model TimetableSlot {
  id                String    @id @default(uuid())
  classId           String
  subjectTeachingId String
  dayOfWeek         DayOfWeek
  startTime         String // "08:00"
  endTime           String // "09:00"
  room              String?
  academicYear      String

  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectTeaching SubjectTeaching @relation(fields: [subjectTeachingId], references: [id])

  @@map("timetable_slots")
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSIGNMENTS & HOMEWORK
// ─────────────────────────────────────────────────────────────────────────────

model Assignment {
  id           String   @id @default(uuid())
  schoolId     String
  subjectId    String
  classId      String? // null = all classes for this subject
  termId       String
  createdById  String
  title        String
  description  String?
  instructions String?
  type         String   @default("HOMEWORK") // HOMEWORK | PROJECT | LAB | ESSAY
  totalMarks   Float    @default(100)
  passingMarks Float    @default(50)
  dueDate      DateTime
  isPublished  Boolean  @default(false)
  allowLate    Boolean  @default(false)
  attachments  String[] @default([]) // S3 URLs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id])
  term          AcademicTerm   @relation(fields: [termId], references: [id])
  createdBy     User           @relation("AssignmentCreator", fields: [createdById], references: [id])
  submissions   Submission[]
  notifications Notification[]

  @@map("assignments")
}

model Submission {
  id            String           @id @default(uuid())
  assignmentId  String
  studentId     String // User.id
  status        SubmissionStatus @default(PENDING)
  content       String?
  attachments   String[]         @default([])
  submittedAt   DateTime?
  marksObtained Float?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id])
  gradedBy   User?      @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAMS & RESULTS
// ─────────────────────────────────────────────────────────────────────────────

model Exam {
  id           String   @id @default(uuid())
  schoolId     String
  subjectId    String
  classId      String?
  gradeLevelId String?
  termId       String
  title        String
  examType     ExamType @default(MID_TERM)
  totalMarks   Float    @default(100)
  passingMarks Float    @default(50)
  duration     Int // minutes
  scheduledAt  DateTime
  venue        String?
  instructions String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject    Subject      @relation(fields: [subjectId], references: [id])
  class      Class?       @relation(fields: [classId], references: [id])
  gradeLevel GradeLevel?  @relation(fields: [gradeLevelId], references: [id])
  term       AcademicTerm @relation(fields: [termId], references: [id])
  results    ExamResult[]

  @@map("exams")
}

model ExamResult {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Float
  grade         String? // A, B, C, F — computed
  remarks       String?
  isAbsent      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@map("exam_results")
}

model GradeReport {
  id             String    @id @default(uuid())
  studentId      String
  termId         String
  classId        String
  gpa            Float?
  totalMarks     Float?
  percentage     Float?
  rank           Int?
  remarks        String?
  teacherComment String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])
  term    AcademicTerm   @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@map("grade_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceRecord {
  id         String           @id @default(uuid())
  schoolId   String
  studentId  String // User.id
  classId    String
  termId     String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(ABSENT)
  note       String?
  markedById String // Teacher User.id
  markedAt   DateTime         @default(now())

  student  User         @relation("StudentAttendance", fields: [studentId], references: [id])
  class    Class        @relation(fields: [classId], references: [id])
  term     AcademicTerm @relation(fields: [termId], references: [id])
  markedBy User         @relation("TeacherAttendance", fields: [markedById], references: [id])

  @@unique([studentId, classId, date])
  @@index([schoolId, date])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// BEHAVIOUR TRACKING
// ─────────────────────────────────────────────────────────────────────────────

model BehaviourRecord {
  id             String            @id @default(uuid())
  schoolId       String
  studentId      String // User.id
  reportedById   String // Teacher User.id
  type           BehaviourType
  severity       BehaviourSeverity @default(LOW)
  title          String
  description    String
  actionTaken    String?
  points         Int               @default(0) // +ve merit, -ve demerit
  date           DateTime
  isResolved     Boolean           @default(false)
  parentNotified Boolean           @default(false)
  attachments    String[]          @default([])
  createdAt      DateTime          @default(now())

  student    User @relation("StudentBehaviour", fields: [studentId], references: [id])
  reportedBy User @relation("TeacherReports", fields: [reportedById], references: [id])

  @@index([schoolId, studentId])
  @@map("behaviour_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT & MESSAGING
// ─────────────────────────────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(uuid())
  schoolId  String
  name      String?
  type      RoomType @default(DIRECT)
  classId   String?  @unique // for CLASS rooms
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class?           @relation("ClassChatRoom", fields: [classId], references: [id])
  members  ChatRoomMember[]
  messages Message[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("chat_room_members")
}

model Message {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String
  type      MessageType @default(TEXT)
  content   String?
  fileUrl   String?
  fileName  String?
  isEdited  Boolean     @default(false)
  isDeleted Boolean     @default(false)
  replyToId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  room      ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User              @relation("MessageSender", fields: [senderId], references: [id])
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]         @relation("MessageReplies")
  reactions MessageReaction[]

  @@index([roomId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String
  authorId    String
  classId     String? // if target = CLASS (single class legacy / primary)
  classIds    String[]             @default([]) // multi-class targeting
  gradeLevelId String?             // if target = GRADE_LEVEL or for cascading
  title       String
  content     String
  target      AnnouncementTarget   @default(ALL)
  priority    AnnouncementPriority @default(NORMAL)
  isPinned    Boolean              @default(false)
  attachments String[]             @default([])
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author     User        @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  class      Class?      @relation(fields: [classId], references: [id])
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id])

  @@index([schoolId, publishedAt])
  @@map("announcements")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEETINGS (Parent-Teacher)
// ─────────────────────────────────────────────────────────────────────────────

model Meeting {
  id          String        @id @default(uuid())
  schoolId    String
  teacherId   String // User.id
  parentId    String // User.id
  studentId   String?
  title       String
  agenda      String?
  scheduledAt DateTime
  duration    Int           @default(30) // minutes
  location    String? // room or "Online"
  meetingLink String?
  status      MeetingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teacher User @relation("TeacherMeetings", fields: [teacherId], references: [id])
  parent  User @relation("ParentMeetings", fields: [parentId], references: [id])

  @@index([schoolId, scheduledAt])
  @@map("meetings")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEES & FINANCE
// ─────────────────────────────────────────────────────────────────────────────

model FeeTemplate {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  type        FeeType  @default(TUITION)
  amount      Float
  dueDay      Int      @default(1) // day of month
  termBased   Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("fee_templates")
}

model FeeInvoice {
  id               String            @id @default(uuid())
  schoolId         String
  studentProfileId String
  title            String
  type             FeeType           @default(TUITION)
  amount           Float
  paidAmount       Float             @default(0)
  discount         Float             @default(0)
  discountType     String            @default("AMOUNT") // "AMOUNT" | "PERCENT"
  taxRate          Float             @default(0) // percent
  taxAmount        Float             @default(0) // computed tax amount
  dueDate          DateTime
  status           FeeStatus         @default(PENDING)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id])
  feePayments      FeePayment[]
  installmentPlans InstallmentPlan[]

  // Hostel / Dormitory
  hostelAllocations HostelAllocation[]

  @@index([schoolId, status])
  @@map("fee_invoices")
}

model FeePayment {
  id                 String   @id @default(uuid())
  invoiceId          String
  amount             Float
  method             String // CASH | BANK_TRANSFER | STRIPE | MPESA
  reference          String?
  stripePaymentId    String?
  paidAt             DateTime @default(now())
  receipt            String?
  provisionalReceipt String? // draft/pre-receipt reference before final save
  receiptCopies      Int      @default(1) // 1 = single receipt, 2 = double (school + parent)

  invoice            FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("fee_payments")
}

model InstallmentPlan {
  id               String   @id @default(uuid())
  studentProfileId String
  invoiceId        String?
  totalAmount      Float
  numInstallments  Int
  taxRate          Float    @default(0)
  discount         Float    @default(0)
  createdAt        DateTime @default(now())

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  invoice          FeeInvoice?    @relation(fields: [invoiceId], references: [id])
  installments     Installment[]

  @@map("installment_plans")
}

model Installment {
  id             String    @id @default(uuid())
  planId         String
  installmentNo  Int
  dueDate        DateTime
  amount         Float
  tax            Float     @default(0)
  total          Float
  payDate        DateTime?
  payAmount      Float?
  receiptNo      String?
  noCarryForward Boolean   @default(false)

  plan           InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("installments")
}

model LookupValue {
  id       String  @id @default(uuid())
  schoolId String
  type     String // "RELIGION" | "CATEGORY" | "FEE_CATEGORY" | "SOURCE" | "HOUSE" | "CURRICULUM" | "PREVIOUS_SCHOOL"
  value    String
  colorHex String? // For HOUSE strip color or badge tags
  isActive Boolean @default(true)

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentReligions       StudentProfile[] @relation("StudentReligion")
  studentCategories      StudentProfile[] @relation("StudentCategory")
  studentFeeCategories   StudentProfile[] @relation("StudentFeeCategory")
  studentSources         StudentProfile[] @relation("StudentSource")
  studentHouses          StudentProfile[] @relation("StudentHouse")
  studentCurriculums     StudentProfile[] @relation("StudentCurriculum")
  studentPreviousSchools StudentProfile[] @relation("StudentPreviousSchool")

  teacherReligions       TeacherProfile[] @relation("TeacherReligion")
  teacherHouses          TeacherProfile[] @relation("TeacherHouse")
  adminReligions         AdminProfile[]   @relation("AdminReligion")

  // HR & Recruiting
  employeeDepartments    Employee[]       @relation("EmployeeDepartment")
  employeePositions      Employee[]       @relation("EmployeePosition")
  requisitionDepartments JobRequisition[] @relation("RequisitionDepartment")
  requisitionPositions   JobRequisition[] @relation("RequisitionPosition")
  postingDepartments     JobPosting[]     @relation("PostingDepartment")
  postingPositions       JobPosting[]     @relation("PostingPosition")

  // Curriculum
  curriculumStandards    CurriculumStandard[] @relation("StandardCurriculum")
  curriculumUnits        CurriculumUnit[]     @relation("UnitCurriculum")

  @@index([schoolId, type])
  @@map("lookup_values")
}

// ─────────────────────────────────────────────────────────────────────────────
// LIBRARY
// ─────────────────────────────────────────────────────────────────────────────

model LibraryBook {
  id                String     @id @default(uuid())
  schoolId          String
  title             String
  author            String
  isbn              String?
  edition           String?
  language          String?
  description       String?
  category          String
  tags              String[]   @default([])
  publisher         String?
  year              Int?
  copies            Int        @default(1)
  available         Int        @default(1)
  condition         String?
  acquisitionSource String?
  price             Float?
  digitalCopyUrl    String?
  barcodeNumber     String?
  status            BookStatus @default(AVAILABLE)
  coverUrl          String?
  location          String? // shelf reference
  createdAt         DateTime   @default(now())

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues LibraryIssue[]

  @@map("library_books")
}

model LibraryIssue {
  id               String    @id @default(uuid())
  bookId           String
  studentProfileId String
  issuedAt         DateTime  @default(now())
  dueDate          DateTime
  returnedAt       DateTime?
  fine             Float     @default(0)
  finePaid         Boolean   @default(false)
  notes            String?

  book           LibraryBook    @relation(fields: [bookId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("library_issues")
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF (HR, Leave, Payroll)
// ─────────────────────────────────────────────────────────────────────────────

model LeaveRequest {
  id               String          @id @default(uuid())
  teacherProfileId String?
  employeeId       String?
  type             String // SICK | ANNUAL | MATERNITY | UNPAID
  startDate        DateTime
  endDate          DateTime
  reason           String
  status           LeaveStatus     @default(PENDING)
  approvedById     String?
  approvedAt       DateTime?
  documents        String[]        @default([])
  createdAt        DateTime        @default(now())

  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  employee         Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("leave_requests")
}

model PayrollRecord {
  id               String          @id @default(uuid())
  teacherProfileId String?
  employeeId       String?
  month            Int
  year             Int
  baseSalary       Float
  allowances       Float           @default(0)
  deductions       Float           @default(0)
  netPay           Float
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime        @default(now())

  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  employee         Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, month, year])
  @@index([employeeId, month, year])
  @@map("payroll_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// FILES & RESOURCES
// ─────────────────────────────────────────────────────────────────────────────

model File {
  id           String   @id @default(uuid())
  schoolId     String
  uploadedById String
  name         String
  url          String
  size         Int
  mimeType     String
  category     String? // SYLLABUS | RESOURCE | REPORT | OTHER
  classId      String?
  subjectId    String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@map("files")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────────────────────────────────────

model SchoolEvent {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  type        String    @default("GENERAL") // HOLIDAY | EXAM | SPORTS | CULTURAL | GENERAL
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id           String           @id @default(uuid())
  schoolId     String
  userId       String
  type         NotificationType
  title        String
  body         String
  data         Json? // extra payload (assignmentId, examId, etc.)
  isRead       Boolean          @default(false)
  readAt       DateTime?
  assignmentId String?
  createdAt    DateTime         @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI INSIGHTS
// ─────────────────────────────────────────────────────────────────────────────

model AiInsight {
  id               String   @id @default(uuid())
  studentProfileId String
  type             String // PERFORMANCE | RISK | RECOMMENDATION | SUMMARY
  title            String
  content          String
  score            Float?
  riskLevel        String? // LOW | MEDIUM | HIGH
  metadata         Json?
  generatedAt      DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSPORT
// ─────────────────────────────────────────────────────────────────────────────

model BusRoute {
  id          String  @id @default(uuid())
  schoolId    String
  name        String
  description String?
  driver      String?
  driverPhone String?
  capacity    Int     @default(40)
  isActive    Boolean @default(true)

  students StudentProfile[]
  School   School           @relation(fields: [schoolId], references: [id])

  @@map("bus_routes")
}

// Relations added to ExamResult
// (added inline above: ExamResult -> StudentProfile)

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC YEAR SUMMARIES & CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

model AcademicYearSummary {
  id                String   @id @default(uuid())
  studentProfileId  String
  academicYear      String
  classId           String
  overallAverage    Float?
  overallRank       Int?
  termBreakdown     Json     // [{ termId, termName, gpa, percentage, rank }, ...] — snapshot at generation time
  isPassing         Boolean  @default(false)
  isPublished       Boolean  @default(false)
  publishedAt       DateTime?
  generatedAt       DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([studentProfileId, academicYear])
  @@map("academic_year_summaries")
}

model Certificate {
  id               String                    @id @default(uuid())
  schoolId         String
  type             CertificateType
  recipientType    CertificateRecipientType
  studentProfileId String?                   // set when recipientType = STUDENT
  userId           String?                   // set when recipientType = STAFF (TEACHER/ADMIN/etc. user)
  academicYear     String?                   // relevant mainly for GRADUATION
  title            String                    // e.g. "Certificate of Academic Excellence"
  reason           String?                   // free text: criteria/achievement description
  issueDate        DateTime                  @default(now())
  layout           String                    @default("ONE_SIDED") // "ONE_SIDED" | "TWO_SIDED"
  signedById       String?                   // e.g. principal/admin issuing signature
  createdAt        DateTime                  @default(now())

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  user           User?           @relation("CertificateRecipient", fields: [userId], references: [id])
  signedBy       User?           @relation("CertificateSigner", fields: [signedById], references: [id])
  ceremonyParticipants CeremonyParticipant[]

  @@index([schoolId, type])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNUAL PLANS (Teacher Scheme of Work & School-wide Plans)
// ─────────────────────────────────────────────────────────────────────────────

model AnnualPlan {
  id               String            @id @default(uuid())
  schoolId         String
  scope            AnnualPlanScope
  createdById      String            // User.id — the teacher or admin who authored it
  teacherProfileId String?           // set when scope = TEACHER_SUBJECT
  subjectId        String?           // set when scope = TEACHER_SUBJECT
  classId          String?           // optional — plan may be class-specific or apply across all classes for that subject
  gradeLevelId     String?           // for SCHOOL_WIDE plans scoped to a grade level, optional
  academicYear     String
  title            String
  columns          Json              // array of column header labels, e.g. ["Term","Topic","Objectives","Activities","Resources","Assessment","Weeks"]
  rows             Json              // array of row objects/arrays matching the columns
  status           AnnualPlanStatus  @default(DRAFT)
  submittedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("AnnualPlanCreator", fields: [createdById], references: [id])
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  reviewedBy     User?           @relation("AnnualPlanReviewer", fields: [reviewedById], references: [id])

  @@index([schoolId, academicYear])
  @@map("annual_plans")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT SUPPORT PROGRAMS & WELFARE
// ─────────────────────────────────────────────────────────────────────────────

model SupportProgram {
  id            String             @id @default(uuid())
  schoolId      String
  type          SupportProgramType
  name          String
  description   String?
  waiverPercent Float? // 0-100, for FINANCIAL_AID/SCHOLARSHIP types — % of tuition fees waived while active; null = no automatic fee effect
  academicYear  String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments StudentSupportEnrollment[]

  @@index([schoolId, type])
  @@map("support_programs")
}

model StudentSupportEnrollment {
  id               String                  @id @default(uuid())
  studentProfileId String
  supportProgramId String
  status           SupportEnrollmentStatus @default(ACTIVE)
  startDate        DateTime                @default(now())
  endDate          DateTime?
  notes            String? // confidential — visibility restricted to admin/finance
  approvedById     String // User.id, admin/finance who approved
  createdAt        DateTime                @default(now())

  studentProfile          StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  supportProgram          SupportProgram           @relation(fields: [supportProgramId], references: [id])
  approvedBy              User                     @relation("SupportEnrollmentApprover", fields: [approvedById], references: [id])
  mealDistributionRecords MealDistributionRecord[]

  @@index([studentProfileId])
  @@map("student_support_enrollments")
}

model MealDistributionRecord {
  id                         String   @id @default(uuid())
  studentSupportEnrollmentId String
  date                       DateTime @db.Date
  recordedById               String // User.id, staff who logged distribution
  notes                      String?

  enrollment StudentSupportEnrollment @relation(fields: [studentSupportEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([studentSupportEnrollmentId, date])
  @@map("meal_distribution_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// TUTORIALS & EXTRA LECTURE SESSIONS
// ─────────────────────────────────────────────────────────────────────────────

model TutorialSession {
  id               String      @id @default(uuid())
  schoolId         String
  title            String
  subjectId        String?
  classId          String? // optional — target single class or open across grade/subject
  gradeLevelId     String?
  teacherProfileId String
  dayOfWeek        DayOfWeek? // set for recurring weekly sessions
  specificDate     DateTime? // set for one-off sessions instead of a recurring day
  startTime        String // "16:00"
  endTime          String // "17:30"
  location         String?
  capacity         Int?
  isRecurring      Boolean     @default(true)
  academicYear     String
  createdAt        DateTime    @default(now())

  school         School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject?                   @relation(fields: [subjectId], references: [id])
  class          Class?                     @relation(fields: [classId], references: [id])
  gradeLevel     GradeLevel?                @relation(fields: [gradeLevelId], references: [id])
  teacherProfile TeacherProfile             @relation(fields: [teacherProfileId], references: [id])
  enrollments    TutorialEnrollment[]
  attendance     TutorialAttendanceRecord[]

  @@index([schoolId, academicYear])
  @@map("tutorial_sessions")
}

model TutorialEnrollment {
  id                String                   @id @default(uuid())
  tutorialSessionId String
  studentProfileId  String
  status            TutorialEnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime                 @default(now())

  tutorialSession TutorialSession @relation(fields: [tutorialSessionId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorialSessionId, studentProfileId])
  @@map("tutorial_enrollments")
}

model TutorialAttendanceRecord {
  id                String           @id @default(uuid())
  tutorialSessionId String
  studentProfileId  String
  date              DateTime         @db.Date
  status            AttendanceStatus @default(ABSENT)
  markedById        String

  tutorialSession TutorialSession @relation(fields: [tutorialSessionId], references: [id], onDelete: Cascade)

  @@unique([tutorialSessionId, studentProfileId, date])
  @@map("tutorial_attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTERNAL EXAM CHECKPOINTS & RECORDS (Regional / National Exams)
// ─────────────────────────────────────────────────────────────────────────────

model ExternalExamCheckpoint {
  id                String   @id @default(uuid())
  schoolId          String
  gradeLevelId      String
  academicYear      String
  name              String    // e.g. "Grade 6 Regional Examination", "ESSLCE / University Entrance Examination"
  administeringBody String?   // e.g. "Regional Education Bureau", "EAES"
  examWindowStart   DateTime?
  examWindowEnd     DateTime?
  passCutoff        Float?    // the officially published passing/cutoff mark, if known — informational, doesn't replace per-record isPassing
  notes             String?
  createdAt         DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  records    ExternalExamRecord[]

  @@unique([schoolId, gradeLevelId, academicYear])
  @@map("external_exam_checkpoints")
}

model ExternalExamRecord {
  id                 String   @id @default(uuid())
  checkpointId       String
  studentProfileId   String
  registrationNumber String?
  examCenter         String?
  status             ExternalExamRegistrationStatus @default(NOT_REGISTERED)
  score              Float?
  grade              String?    // for bodies that issue a band/letter rather than a raw score
  isPassing          Boolean?
  resultDocumentUrl  String?    // uploaded scan of the official result slip/certificate
  resultPublishedAt  DateTime?
  recordedById       String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  checkpoint     ExternalExamCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  recordedBy     User?                  @relation("ExternalExamRecorder", fields: [recordedById], references: [id])

  @@unique([checkpointId, studentProfileId])
  @@index([checkpointId, status])
  @@map("external_exam_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADUATION & COMPLETION CEREMONIES
// ─────────────────────────────────────────────────────────────────────────────

model CeremonyEvent {
  id           String       @id @default(uuid())
  schoolId     String
  gradeLevelId String?      // the milestone grade level this ceremony celebrates (e.g. final KG year); optional for a whole-school event
  type         CeremonyType @default(GRADUATION)
  academicYear String
  title        String       // e.g. "Kindergarten Graduation 2026"
  ceremonyDate DateTime?
  venue        String?
  attireNote   String?      // e.g. "Cap and gown, provided by school"
  program      String?      // free-text agenda/order of program
  createdAt    DateTime     @default(now())

  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel?           @relation(fields: [gradeLevelId], references: [id])
  participants CeremonyParticipant[]

  @@map("ceremony_events")
}

model CeremonyParticipant {
  id                  String   @id @default(uuid())
  ceremonyEventId     String
  studentProfileId    String
  certificateId       String?  // linked once a GRADUATION certificate is issued for this participant
  attendanceConfirmed Boolean  @default(false)
  createdAt           DateTime @default(now())

  ceremonyEvent  CeremonyEvent  @relation(fields: [ceremonyEventId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  certificate    Certificate?   @relation(fields: [certificateId], references: [id])

  @@unique([ceremonyEventId, studentProfileId])
  @@map("ceremony_participants")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR & RECRUITING MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id                String         @id @default(uuid())
  schoolId          String
  userId            String?        @unique
  employeeNumber    String         // e.g. EMP-2026-001
  firstName         String
  middleName        String?
  lastName          String
  email             String?
  phone             String?
  avatar            String?
  gender            Gender?
  dateOfBirth       DateTime?
  nationalId        String?
  hireDate          DateTime       @default(now())
  employmentType    EmploymentType @default(FULL_TIME)
  status            EmployeeStatus @default(ACTIVE)

  departmentId      String?
  positionId        String?
  managerId         String?

  salary            Float?
  contractStart     DateTime?
  contractEnd       DateTime?
  probationEnd      DateTime?

  address           String?
  city              String?
  emergencyContact  String?
  emergencyPhone    String?
  bankName          String?
  bankAccountNumber String?
  notes             String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  school            School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        LookupValue?   @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position          LookupValue?   @relation("EmployeePosition", fields: [positionId], references: [id])
  manager           Employee?      @relation("EmployeeReportingLine", fields: [managerId], references: [id])
  directReports     Employee[]     @relation("EmployeeReportingLine")

  documents         EmployeeDocument[]
  onboardingChecklists OnboardingChecklist[]
  disciplinaryRecords  StaffDisciplinaryRecord[]
  performanceReviews   PerformanceReview[] @relation("EmployeePerformanceReviews")
  trainingRecords      StaffTraining[]
  offboardingRecords   OffboardingRecord[]
  leaveRequests        LeaveRequest[]
  payrollRecords       PayrollRecord[]

  hiredFromApplications JobApplication[]

  // Hostel / Dormitory
  hostelWardenOf           Hostel[]                  @relation("HostelWarden")
  hostelStaffAssignments   HostelStaffAssignment[]   @relation("HostelStaffAssignments")
  hostelMaintenanceTickets HostelMaintenanceTicket[] @relation("TicketAssignee")

  @@unique([schoolId, employeeNumber])
  @@index([schoolId, status])
  @@index([schoolId, departmentId])
  @@index([schoolId, positionId])
  @@map("employees")
}

model JobRequisition {
  id                String            @id @default(uuid())
  schoolId          String
  requisitionNumber String            // e.g. REQ-2026-01
  title             String
  departmentId      String?
  positionId        String?
  vacanciesCount    Int               @default(1)
  employmentType    EmploymentType    @default(FULL_TIME)
  reason            String?           // REPLACEMENT | EXPANSION | NEW_SECTION
  salaryMin         Float?
  salaryMax         Float?
  description       String?
  justification     String?
  status            RequisitionStatus @default(DRAFT)
  requestedById     String?
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  targetStartDate   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department        LookupValue?      @relation("RequisitionDepartment", fields: [departmentId], references: [id])
  position          LookupValue?      @relation("RequisitionPosition", fields: [positionId], references: [id])
  requestedBy       User?             @relation("RequisitionRequester", fields: [requestedById], references: [id])
  approvedBy        User?             @relation("RequisitionApprover", fields: [approvedById], references: [id])

  postings          JobPosting[]

  @@unique([schoolId, requisitionNumber])
  @@index([schoolId, status])
  @@map("job_requisitions")
}

model JobPosting {
  id                        String            @id @default(uuid())
  schoolId                  String
  requisitionId             String?
  title                     String
  slug                      String
  departmentId              String?
  positionId                String?
  employmentType            EmploymentType    @default(FULL_TIME)
  location                  String?           // Campus / Location
  description               String
  requirements              String?
  benefits                  String?
  salaryRange               String?
  closingDate               DateTime?
  status                    PostingStatus     @default(DRAFT)
  publishedAt               DateTime?

  // Marketing Flyer & Customization Fields
  bannerImageUrl            String?           // set from Cloudinary URL via files/upload
  companyTagline            String?
  salaryType                SalaryType        @default(RANGE)
  salaryFixedAmount         Float?
  salaryCurrency            String?           @default("USD")
  applicationDeadlineNote   String?
  socialLinks               Json?
  flyerTheme                String?           @default("default")
  contactEmail              String?
  contactPhone              String?
  telegramPostedAt          DateTime?
  telegramMessageId         Int?
  telegramChannelId         String?

  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  school                    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requisition               JobRequisition?   @relation(fields: [requisitionId], references: [id])
  department                LookupValue?      @relation("PostingDepartment", fields: [departmentId], references: [id])
  position                  LookupValue?      @relation("PostingPosition", fields: [positionId], references: [id])

  applications              JobApplication[]

  @@unique([schoolId, slug])
  @@index([schoolId, status])
  @@map("job_postings")
}

model JobApplication {
  id                String            @id @default(uuid())
  schoolId          String
  postingId         String
  candidateName     String
  email             String
  phone             String?
  resumeUrl         String?
  coverLetter       String?
  portfolioUrl      String?
  experienceYears   Float?
  currentEmployer   String?
  highestEducation  String?
  stage             ApplicationStage  @default(APPLIED)
  rating            Float?            // 1 to 5 stars
  rejectionReason   String?
  notes             String?
  hiredEmployeeId   String?
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  posting           JobPosting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  hiredEmployee     Employee?         @relation(fields: [hiredEmployeeId], references: [id])

  interviews        JobInterview[]
  offers            JobOffer[]

  @@index([schoolId, stage])
  @@index([postingId, stage])
  @@map("job_applications")
}

model JobInterview {
  id                String            @id @default(uuid())
  schoolId          String
  applicationId     String
  title             String            // e.g. "Round 1 Interview"
  scheduledAt       DateTime
  durationMinutes   Int               @default(45)
  format            InterviewFormat   @default(IN_PERSON)
  locationOrLink    String?           // Room or meeting URL
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application       JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewers      User[]            @relation("InterviewInterviewer")
  feedbacks         InterviewFeedback[]

  @@index([applicationId])
  @@map("job_interviews")
}

model InterviewFeedback {
  id                String                  @id @default(uuid())
  interviewId       String
  interviewerId     String
  score             Float                   // Overall 1 to 5
  recommendation    InterviewRecommendation @default(HOLD)
  criteriaScores    Json?
  strengths         String?
  concerns          String?
  notes             String?
  createdAt         DateTime                @default(now())

  interview         JobInterview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer       User                    @relation("FeedbackInterviewer", fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@map("interview_feedbacks")
}

model JobOffer {
  id                String            @id @default(uuid())
  schoolId          String
  applicationId     String
  offerNumber       String            // e.g. OFR-2026-001
  positionTitle     String
  departmentName    String?
  employmentType    EmploymentType    @default(FULL_TIME)
  offeredSalary     Float
  salaryPeriod      String            @default("MONTHLY") // MONTHLY | ANNUAL
  startDate         DateTime
  probationMonths   Int               @default(3)
  benefits          String?
  conditions        String?
  status            OfferStatus       @default(DRAFT)
  sentAt            DateTime?
  expiresAt         DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  signedLetterUrl   String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application       JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, offerNumber])
  @@map("job_offers")
}

model OnboardingChecklist {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  title             String            // e.g. "New Employee Onboarding"
  status            OnboardingStatus  @default(IN_PROGRESS)
  dueDate           DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items             OnboardingItem[]

  @@map("onboarding_checklists")
}

model OnboardingItem {
  id                String               @id @default(uuid())
  checklistId       String
  title             String
  description       String?
  category          String?              // DOCUMENTATION | IT_SETUP | ORIENTATION | LOGISTICS
  status            OnboardingItemStatus @default(PENDING)
  isRequired        Boolean              @default(true)
  completedAt       DateTime?
  completedById     String?
  notes             String?

  checklist         OnboardingChecklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("onboarding_items")
}

model EmployeeDocument {
  id                String               @id @default(uuid())
  schoolId          String
  employeeId        String
  type              EmployeeDocumentType @default(OTHER)
  title             String
  documentNumber    String?
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  issueDate         DateTime?
  expiryDate        DateTime?
  reminderDays      Int                  @default(30)
  isVerified        Boolean              @default(false)
  verifiedById      String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, expiryDate])
  @@index([employeeId, type])
  @@map("employee_documents")
}

model PerformanceReview {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  reviewerId        String
  cycleName         String            // e.g. "Annual Review 2025/2026"
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime
  selfReviewNotes   String?
  reviewerNotes     String?
  competencyScores  Json?
  overallRating     Float?            // 1 to 5
  goalsSet          String?
  developmentPlan   String?
  status            String            @default("DRAFT") // DRAFT | SUBMITTED | COMPLETED
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation("EmployeePerformanceReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer          User              @relation("PerformanceReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId])
  @@map("performance_reviews")
}

model StaffTraining {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  title             String
  provider          String?
  category          String?           // PEDAGOGY | LEADERSHIP | TECH | SAFETY | SPECIAL_ED
  hoursCompleted    Float?
  startDate         DateTime?
  completionDate    DateTime
  expiryDate        DateTime?
  certificateUrl    String?
  notes             String?
  createdAt         DateTime          @default(now())

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("staff_trainings")
}

model StaffDisciplinaryRecord {
  id                String                @id @default(uuid())
  schoolId          String
  employeeId        String
  type              StaffDisciplinaryType @default(WRITTEN_WARNING)
  incidentDate      DateTime              @default(now())
  title             String
  description       String
  actionTaken       String?
  isResolved        Boolean               @default(false)
  resolvedAt        DateTime?
  resolutionNotes   String?
  recordedById      String?
  documentUrl       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("staff_disciplinary_records")
}

model OffboardingRecord {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  type              String            // RESIGNATION | TERMINATION | RETIREMENT | END_OF_CONTRACT
  reason            String?
  noticeDate        DateTime?
  lastWorkingDay    DateTime
  exitInterviewNotes String?
  finalSettlementNotes String?
  status            OffboardingStatus @default(INITIATED)
  completedAt       DateTime?
  userDeactivated   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklistItems    ExitChecklistItem[]

  @@map("offboarding_records")
}

model ExitChecklistItem {
  id                String            @id @default(uuid())
  offboardingId     String
  title             String            // e.g. "Laptop Return", "Revoke Email Access"
  category          String?           // ASSETS | IT_ACCESS | FINANCE | HR
  isCompleted       Boolean           @default(false)
  completedAt       DateTime?
  completedBy       String?
  notes             String?

  offboarding       OffboardingRecord @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@map("exit_checklist_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// CURRICULUM MAPPING & LEARNING STANDARDS
// ─────────────────────────────────────────────────────────────────────────────

model CurriculumStandard {
  id           String       @id @default(uuid())
  schoolId     String
  subjectId    String
  gradeLevelId String?
  curriculumId String?      // LookupValue CURRICULUM
  code         String       // e.g. "SC8.1", "ENG.L.7.1"
  title        String       // e.g. "Explain the water cycle"
  description  String?
  category     String?      // e.g. "Earth & Space Sciences"
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel?  @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  curriculum   LookupValue? @relation("StandardCurriculum", fields: [curriculumId], references: [id], onDelete: SetNull)

  unitStandards CurriculumUnitStandard[]

  @@unique([schoolId, subjectId, code])
  @@index([schoolId, subjectId, gradeLevelId])
  @@map("curriculum_standards")
}

model CurriculumUnit {
  id               String               @id @default(uuid())
  schoolId         String
  subjectId        String
  gradeLevelId     String
  curriculumId     String?              // LookupValue CURRICULUM
  academicYear     String
  unitNumber       Int                  @default(1)
  title            String
  description      String?
  durationWeeks    Int?
  startDate        DateTime?
  endDate          DateTime?
  learningObjectives Json?              // Array of objectives / competencies
  assessmentMethod String?
  keyResources     Json?                // Array of attached/linked resources [{ name, url, fileId, type }]
  status           CurriculumUnitStatus @default(DRAFT)
  createdById      String
  teacherProfileId String?
  submittedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  currentVersion   Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  school         School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel     GradeLevel               @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  curriculum     LookupValue?             @relation("UnitCurriculum", fields: [curriculumId], references: [id], onDelete: SetNull)
  createdBy      User                     @relation("CurriculumUnitCreator", fields: [createdById], references: [id])
  teacherProfile TeacherProfile?          @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)
  reviewedBy     User?                    @relation("CurriculumUnitReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  unitStandards  CurriculumUnitStandard[]
  versions       CurriculumUnitVersion[]

  @@index([schoolId, subjectId, gradeLevelId, academicYear])
  @@map("curriculum_units")
}

model CurriculumUnitStandard {
  id               String             @id @default(uuid())
  curriculumUnitId String
  standardId       String
  createdAt        DateTime           @default(now())

  curriculumUnit   CurriculumUnit     @relation(fields: [curriculumUnitId], references: [id], onDelete: Cascade)
  standard         CurriculumStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([curriculumUnitId, standardId])
  @@map("curriculum_unit_standards")
}

model CurriculumUnitVersion {
  id               String         @id @default(uuid())
  curriculumUnitId String
  versionNumber    Int
  snapshot         Json           // Snapshot of title, description, objectives, assessmentMethod, keyResources, standards
  changeSummary    String?
  createdById      String
  createdAt        DateTime       @default(now())

  curriculumUnit   CurriculumUnit @relation(fields: [curriculumUnitId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("CurriculumUnitVersionCreator", fields: [createdById], references: [id])

  @@index([curriculumUnitId, versionNumber])
  @@map("curriculum_unit_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// POLICY MANAGEMENT & COMPLIANCE
// ─────────────────────────────────────────────────────────────────────────────

model Policy {
  id                   String               @id @default(uuid())
  schoolId             String
  category             PolicyCategory       @default(OTHER)
  title                String
  summary              String?
  ownerId              String               // User.id of staff member responsible
  targetAudience       PolicyTargetAudience @default(ALL_STAFF)
  isPubliclyVisible    Boolean              @default(false)
  nextReviewDate       DateTime?
  reviewIntervalMonths Int                  @default(12)
  status               PolicyStatus         @default(DRAFT)
  currentVersionId     String?
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  owner           User                   @relation("PolicyOwner", fields: [ownerId], references: [id])
  createdBy       User                   @relation("PolicyCreator", fields: [createdById], references: [id])

  versions        PolicyVersion[]
  acknowledgments PolicyAcknowledgment[]

  @@index([schoolId, category, status])
  @@map("policies")
}

model PolicyVersion {
  id               String               @id @default(uuid())
  schoolId         String
  policyId         String
  versionNumber    String               // e.g. "1.0", "1.1", "2.0"
  content          String               // Markdown / formatted content
  attachmentUrl    String?
  attachmentFileId String?
  changeSummary    String?
  status           PolicyStatus         @default(DRAFT)
  createdById      String
  submittedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  publishedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  policy          Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("PolicyVersionCreator", fields: [createdById], references: [id])
  reviewedBy      User?                  @relation("PolicyVersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  acknowledgments PolicyAcknowledgment[]

  @@unique([policyId, versionNumber])
  @@index([policyId, status])
  @@map("policy_versions")
}

model PolicyAcknowledgment {
  id              String        @id @default(uuid())
  schoolId        String
  policyId        String
  policyVersionId String
  userId          String
  isAcknowledged  Boolean       @default(false)
  acknowledgedAt  DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  policy          Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, userId])
  @@index([userId, isAcknowledged])
  @@index([policyId, isAcknowledged])
  @@map("policy_acknowledgments")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMISSIONS / CRM (Prospective Student Pipeline)
// ─────────────────────────────────────────────────────────────────────────────

model Applicant {
  id                   String            @id @default(uuid())
  schoolId             String
  school               School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status               ApplicationStatus @default(SUBMITTED)

  firstName            String
  middleName           String?
  lastName             String
  dateOfBirth          DateTime?
  gender               String?
  gradeLevelAppliedFor String?
  previousSchool       String?

  fatherFirstName      String?
  fatherLastName       String?
  fatherMobile         String?
  motherFirstName      String?
  motherLastName       String?
  motherMobile         String?
  guardianEmail        String
  guardianPhone        String?
  address              String?
  city                 String?
  nationality          String?

  notes                String?           // internal admin notes, not visible to applicant
  reviewedById         String?
  reviewedAt           DateTime?
  rejectionReason      String?

  convertedUserId      String?           // set once accepted + converted to a real User
  convertedAt          DateTime?

  submittedAt          DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([schoolId, status])
  @@map("applicants")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOGS (Sensitive Action Auditing)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  schoolId     String
  actorId      String?     // nullable — some events (failed login) may not resolve to a known user
  actorEmail   String?     // snapshot the email at time of action
  actorRole    String?
  action       String      // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "LOGOUT", "PASSWORD_CHANGED", "MFA_ENABLED", "MFA_DISABLED", "GOOGLE_ACCOUNT_LINKED", "GOOGLE_SIGNIN_BLOCKED_ADMIN", "FEE_RECORD_CREATED", "FEE_RECORD_UPDATED", "PAYROLL_UPDATED", "USER_CREATED", "USER_DEACTIVATED", "SCHOOL_SETTINGS_UPDATED", "GRADE_RESULT_UPDATED", etc.
  targetType   String?     // e.g. "User", "Fee", "SchoolSettings", "Result", "Payroll", "Applicant"
  targetId     String?     // the id of the affected record, if applicable
  metadata     Json?       // free-form extra context
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// HOSTEL / DORMITORY MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

enum HostelType {
  BOYS
  GIRLS
  MIXED   // co-ed campus, gender-segregated at block level
  STAFF
}

enum HostelRoomType {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  DORMITORY
}

enum RoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
  RESERVED
  CLOSED
}

enum BedStatus {
  VACANT
  OCCUPIED
  RESERVED     // held for an approved-but-not-yet-checked-in application
  OUT_OF_SERVICE
}

enum HostelStaffRole {
  WARDEN
  ASSISTANT_WARDEN
  MATRON
  CARETAKER
  SECURITY_GUARD
  NURSE
  COOK
  MAINTENANCE_STAFF
}

enum HostelApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum AllocationStatus {
  ACTIVE
  CHECKED_OUT
  TRANSFERRED
  TERMINATED    // disciplinary / non-payment
  EXPIRED       // term/year ended, not renewed
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum OutpassType {
  DAY_OUT
  OVERNIGHT
  HOME_VISIT
  MEDICAL
  EMERGENCY
}

enum OutpassStatus {
  PENDING
  APPROVED
  REJECTED
  OUT          // student has physically left (gate check-out scanned)
  RETURNED
  OVERDUE
  CANCELLED
}

enum NightAttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  ON_OUTPASS
  MEDICAL_LEAVE
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  FURNITURE
  CLEANING
  PEST_CONTROL
  STRUCTURAL
  IT_NETWORK
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  REPORTED
  ASSIGNED
  IN_PROGRESS
  AWAITING_PARTS
  RESOLVED
  UNRESOLVABLE
  CLOSED
  CANCELLED
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SEVERE
  CRITICAL
}

// ── Physical structure ───────────────────────────────────────────────────────

model Hostel {
  id            String     @id @default(uuid())
  schoolId      String
  name          String
  type          HostelType
  wardenId      String?               // Employee.id of the head warden
  address       String?
  totalCapacity Int        @default(0)   // denormalized, recalculated on room changes
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  warden        Employee?            @relation("HostelWarden", fields: [wardenId], references: [id])
  blocks        HostelBlock[]
  staff         HostelStaffAssignment[]
  applications  HostelApplication[]
  allocations   HostelAllocation[]

  @@index([schoolId])
  @@map("hostels")
}

model HostelBlock {
  id          String   @id @default(uuid())
  hostelId    String
  name        String            // "Block A", "North Wing"
  floorCount  Int      @default(1)
  gradeMin    String?           // optional: restrict block to GradeLevel range (junior/senior wings)
  gradeMax    String?
  isActive    Boolean  @default(true)

  hostel      Hostel        @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms       HostelRoom[]
  staff       HostelStaffAssignment[]

  @@index([hostelId])
  @@map("hostel_blocks")
}

model HostelRoom {
  id          String         @id @default(uuid())
  blockId     String
  roomNumber  String
  floor       Int            @default(1)
  roomType    HostelRoomType
  capacity    Int                 // total beds in the room
  status      RoomStatus     @default(AVAILABLE)
  amenities   Json?               // ["attached_bathroom","balcony","heater"]
  isAccessible Boolean       @default(false)   // ground floor / wheelchair accessible flag

  block       HostelBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  beds        HostelBed[]
  maintenanceTickets HostelMaintenanceTicket[]

  @@unique([blockId, roomNumber])
  @@index([blockId])
  @@map("hostel_rooms")
}

model HostelBed {
  id         String    @id @default(uuid())
  roomId     String
  bedNumber  String            // "A", "B" or "1","2"
  status     BedStatus @default(VACANT)

  room         HostelRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations  HostelAllocation[]  // full history; only one ACTIVE at a time (enforced in service layer)

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@map("hostel_beds")
}

// ── Staffing (thin scoping layer over Employee, mirrors TeacherProfile pattern) ─

model HostelStaffAssignment {
  id         String          @id @default(uuid())
  hostelId   String
  blockId    String?                 // null = whole-hostel authority (e.g. Warden)
  employeeId String
  staffRole  HostelStaffRole
  shift      String?                 // "Day", "Night", "24h"
  isActive   Boolean         @default(true)
  assignedAt DateTime        @default(now())

  hostel     Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  block      HostelBlock? @relation(fields: [blockId], references: [id])
  employee   Employee     @relation("HostelStaffAssignments", fields: [employeeId], references: [id])

  @@index([hostelId])
  @@index([employeeId])
  @@map("hostel_staff_assignments")
}

// ── Intake / CRM-style application ───────────────────────────────────────────

model HostelApplication {
  id                 String                   @id @default(uuid())
  schoolId           String
  hostelId           String?                  // may be null until reviewed/matched
  studentProfileId   String
  academicTermId     String?
  preferredRoomType  HostelRoomType?
  medicalNotes       String?
  specialRequests    String?                  // dietary, mobility, allergy
  roommatePreference String?                  // free text or studentProfileId of requested roommate
  guardianConsent    Boolean                  @default(false)
  priorityScore      Int                      @default(0)   // computed: medical > sibling-in-hostel > distance > FIFO
  status             HostelApplicationStatus  @default(PENDING)
  reviewedById       String?
  reviewNotes        String?
  submittedAt        DateTime                 @default(now())
  reviewedAt         DateTime?

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel         Hostel?         @relation(fields: [hostelId], references: [id])
  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  reviewedBy     User?           @relation("HostelApplicationReviewer", fields: [reviewedById], references: [id])
  allocation     HostelAllocation?

  @@index([schoolId, status])
  @@index([studentProfileId])
  @@map("hostel_applications")
}

// ── The actual assignment ledger (one row per stay, full history retained) ──

model HostelAllocation {
  id               String            @id @default(uuid())
  applicationId    String?           @unique
  hostelId         String
  bedId            String
  studentProfileId String
  academicTermId   String?
  status           AllocationStatus  @default(ACTIVE)
  allocatedById    String                    // staff/system user who ran the allocation
  allocatedAt      DateTime          @default(now())
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  vacateReason     String?
  feeInvoiceId     String?                   // links to FeeInvoice generated on allocation

  application     HostelApplication? @relation(fields: [applicationId], references: [id])
  hostel          Hostel             @relation(fields: [hostelId], references: [id])
  bed             HostelBed          @relation(fields: [bedId], references: [id])
  studentProfile  StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  allocatedBy     User               @relation("HostelAllocator", fields: [allocatedById], references: [id])
  feeInvoice      FeeInvoice?        @relation(fields: [feeInvoiceId], references: [id])
  nightAttendance HostelNightAttendance[]
  outpasses       HostelOutpass[]
  incidentReports HostelIncidentReport[]
  transfersFrom   HostelTransferRequest[]

  @@index([hostelId, status])
  @@index([studentProfileId])
  @@index([bedId])
  @@map("hostel_allocations")
}

model HostelTransferRequest {
  id                String                 @id @default(uuid())
  studentProfileId  String
  fromAllocationId  String
  toBedId           String?                // null = "any suitable bed, let the engine decide"
  reason            String
  status            TransferRequestStatus  @default(PENDING)
  requestedAt       DateTime               @default(now())
  decidedById       String?
  decidedAt         DateTime?
  decisionNotes     String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fromAllocation HostelAllocation @relation(fields: [fromAllocationId], references: [id])
  decidedBy      User?            @relation("TransferDecider", fields: [decidedById], references: [id])

  @@index([studentProfileId])
  @@map("hostel_transfer_requests")
}

// ── Nightly roll call ─────────────────────────────────────────────────────────

model HostelNightAttendance {
  id             String                 @id @default(uuid())
  allocationId   String
  date           DateTime               @db.Date
  status         NightAttendanceStatus
  markedById     String
  remarks        String?
  markedAt       DateTime               @default(now())

  allocation HostelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  markedBy   User             @relation("NightAttendanceMarker", fields: [markedById], references: [id])

  @@unique([allocationId, date])
  @@index([date])
  @@map("hostel_night_attendance")
}

// ── Movement: outpass / leave ────────────────────────────────────────────────

model HostelOutpass {
  id                    String        @id @default(uuid())
  allocationId          String
  type                  OutpassType
  fromDateTime          DateTime
  expectedReturnAt      DateTime
  actualReturnAt        DateTime?
  destination           String
  contactAtDestination  String?
  reason                String
  status                OutpassStatus @default(PENDING)
  approvedById          String?
  parentConsentAt       DateTime?               // stamp when parent co-signs via portal
  gateOutAt             DateTime?               // security scan-out
  gateInAt              DateTime?               // security scan-in
  createdAt             DateTime      @default(now())

  allocation HostelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  approvedBy User?            @relation("OutpassApprover", fields: [approvedById], references: [id])

  @@index([allocationId, status])
  @@map("hostel_outpasses")
}

// ── Visitors ──────────────────────────────────────────────────────────────────

model HostelVisitorLog {
  id                String    @id @default(uuid())
  studentProfileId  String
  visitorName       String
  relationToStudent String
  idProofType       String?
  idProofNumber     String?
  purpose           String?
  checkInAt         DateTime  @default(now())
  checkOutAt        DateTime?
  loggedById        String            // security/gate staff

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  loggedBy       User           @relation("VisitorLogger", fields: [loggedById], references: [id])

  @@index([studentProfileId])
  @@map("hostel_visitor_logs")
}

// ── Maintenance ───────────────────────────────────────────────────────────────

model HostelMaintenanceTicket {
  id            String               @id @default(uuid())
  roomId        String
  category      MaintenanceCategory
  priority      MaintenancePriority  @default(MEDIUM)
  status        MaintenanceStatus    @default(OPEN)
  description   String
  reportedById  String
  assignedToId  String?              // Employee.id (caretaker/vendor)
  cost          Decimal?             @db.Decimal(10, 2)
  reportedAt    DateTime             @default(now())
  resolvedAt    DateTime?

  room         HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reportedBy   User       @relation("TicketReporter", fields: [reportedById], references: [id])
  assignedTo   Employee?  @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@index([roomId, status])
  @@map("hostel_maintenance_tickets")
}

// ── Incidents ─────────────────────────────────────────────────────────────────

model HostelIncidentReport {
  id                String            @id @default(uuid())
  allocationId      String
  severity          IncidentSeverity
  description       String
  actionTaken       String?
  reportedById      String
  linkedBehaviourId String?           // optional FK to your existing BehaviourRecord
  occurredAt        DateTime          @default(now())

  allocation HostelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  reportedBy User             @relation("IncidentReporter", fields: [reportedById], references: [id])

  @@index([allocationId])
  @@map("hostel_incident_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 8: INVENTORY & ASSET MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

enum InventoryLocationType {
  CAMPUS
  BLOCK
  FLOOR
  ROOM
  STORE_BIN
}

enum ItemType {
  FIXED_ASSET
  CONSUMABLE
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  UNDER_REPAIR
  CONDEMNED
}

enum ItemLifecycleStatus {
  IN_STOCK
  ALLOCATED
  UNDER_MAINTENANCE
  RESERVED
  DISPOSED
  LOST
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustodianType {
  STAFF
  STUDENT
  ROOM
  DEPARTMENT
  CLASS
}

enum MovementType {
  RECEIVED
  ALLOCATED
  TRANSFERRED
  RETURNED
  ADJUSTED
  DAMAGED
  LOST
  SENT_FOR_MAINTENANCE
  RETURNED_FROM_MAINTENANCE
  DISPOSED
  WRITTEN_OFF
}

enum DisposalReason {
  OBSOLETE
  DAMAGED_BEYOND_REPAIR
  LOST
  STOLEN
  DONATED
  SOLD
  EXPIRED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  NONE
}

model InventoryLocation {
  id             String                 @id @default(uuid())
  schoolId       String
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  type           InventoryLocationType
  parentId       String?
  parent         InventoryLocation?     @relation("LocationTree", fields: [parentId], references: [id])
  children       InventoryLocation[]    @relation("LocationTree")
  isStoreRoom    Boolean                @default(false)
  isDisposalHold Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  items          InventoryItem[]        @relation("CurrentLocation")
  movementsFrom  InventoryMovement[]    @relation("MovementFrom")
  movementsTo    InventoryMovement[]    @relation("MovementTo")
  stockCounts    StockCount[]
  allocations    InventoryAllocation[]
  goodsReceipts  GoodsReceipt[]

  @@index([schoolId, parentId])
  @@map("inventory_locations")
}

model InventoryCategory {
  id                  String              @id @default(uuid())
  schoolId            String
  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  parentId            String?
  parent              InventoryCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children            InventoryCategory[] @relation("CategoryTree")
  defaultItemType     ItemType            @default(CONSUMABLE)
  defaultUnit         String              @default("piece")
  defaultReorderPoint Int?
  defaultReorderQty   Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  items               InventoryItem[]

  @@index([schoolId, parentId])
  @@map("inventory_categories")
}

model Supplier {
  id           String            @id @default(uuid())
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  taxId        String?
  paymentTerms String?
  rating       Int?              // 1-5, updated from delivery/quality history
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items            InventoryItem[]
  purchaseOrders   PurchaseOrder[]

  @@index([schoolId])
  @@map("inventory_suppliers")
}

model InventoryItem {
  id                String               @id @default(uuid())
  schoolId          String
  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId        String
  category          InventoryCategory    @relation(fields: [categoryId], references: [id])
  name              String
  sku               String?              // internal stock keeping unit
  barcodeNumber     String?              @unique
  qrCodeUrl         String?
  itemType          ItemType
  description       String?
  unit              String               @default("piece")
  imageUrl          String?

  // Fixed-asset-only fields (null for CONSUMABLE)
  serialNumber      String?              @unique
  assetTagNumber    String?              @unique
  purchaseDate      DateTime?
  purchaseCost      Float?
  warrantyExpiresAt DateTime?
  depreciationMethod DepreciationMethod  @default(NONE)
  usefulLifeMonths  Int?
  salvageValue      Float?               @default(0)
  currentBookValue  Float?

  // Consumable-only fields
  quantityOnHand    Int?                 @default(0)
  reorderPoint      Int?
  reorderQty        Int?
  unitCost          Float?

  condition         ItemCondition        @default(NEW)
  status            ItemLifecycleStatus  @default(IN_STOCK)
  currentLocationId String?
  currentLocation   InventoryLocation?   @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  preferredSupplierId String?
  preferredSupplier  Supplier?           @relation(fields: [preferredSupplierId], references: [id])

  notes             String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  allocations       InventoryAllocation[]
  movements         InventoryMovement[]
  maintenanceRecords MaintenanceRecord[]
  poLines           PurchaseOrderLine[]
  requestLines      InventoryRequestLine[]
  disposalRecords   DisposalRecord[]
  stockCountLines   StockCountLine[]

  @@index([schoolId, categoryId])
  @@index([schoolId, status])
  @@map("inventory_items")
}

model InventoryRequest {
  id               String                 @id @default(uuid())
  schoolId         String
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User                   @relation("RequestedBy", fields: [requestedById], references: [id])
  departmentOrRoom String?                // free-text or link to a Class/GradeLevel
  reason           String
  neededBy         DateTime?
  status           RequestStatus          @default(PENDING)
  approvedById     String?
  approvedBy       User?                  @relation("ApprovedRequests", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  lines            InventoryRequestLine[]
  purchaseOrders   PurchaseOrder[]
  allocations      InventoryAllocation[]

  @@index([schoolId, status])
  @@map("inventory_requests")
}

model InventoryRequestLine {
  id                String            @id @default(uuid())
  requestId         String
  request           InventoryRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId            String?           // null if requesting something not yet in the catalog
  item              InventoryItem?    @relation(fields: [itemId], references: [id])
  freeTextName      String?           // used when itemId is null
  quantityRequested Int
  quantityFulfilled Int               @default(0)

  @@map("inventory_request_lines")
}

model PurchaseOrder {
  id                   String               @id @default(uuid())
  schoolId             String
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  poNumber             String               @unique
  supplierId           String
  supplier             Supplier             @relation(fields: [supplierId], references: [id])
  requestId            String?
  request              InventoryRequest?    @relation(fields: [requestId], references: [id])
  status               PurchaseOrderStatus  @default(DRAFT)
  orderedById          String
  orderedBy            User                 @relation("OrderedPOs", fields: [orderedById], references: [id])
  approvedById         String?
  approvedBy           User?                @relation("ApprovedPOs", fields: [approvedById], references: [id])
  expectedDeliveryDate DateTime?
  totalAmount          Float                @default(0)
  currency             String               @default("ETB")
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  lines                PurchaseOrderLine[]
  receipts             GoodsReceipt[]

  @@index([schoolId, status])
  @@map("inventory_purchase_orders")
}

model PurchaseOrderLine {
  id               String         @id @default(uuid())
  poId             String
  po               PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId           String?
  item             InventoryItem? @relation(fields: [itemId], references: [id])
  description      String         // needed when ordering something new to the catalog
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitCost         Float

  goodsReceiptLines GoodsReceiptLine[]

  @@map("inventory_po_lines")
}

model GoodsReceipt {
  id               String            @id @default(uuid())
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  poId             String
  po               PurchaseOrder     @relation(fields: [poId], references: [id])
  receivedById     String
  receivedBy       User              @relation(fields: [receivedById], references: [id])
  receivedAt       DateTime          @default(now())
  locationId       String            // store room the goods land in
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  notes            String?
  discrepancyNotes String?

  lines            GoodsReceiptLine[]

  @@index([schoolId])
  @@map("inventory_goods_receipts")
}

model GoodsReceiptLine {
  id                 String            @id @default(uuid())
  receiptId          String
  receipt            GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLineId           String
  poLine             PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  quantityReceived   Int
  conditionOnArrival ItemCondition     @default(NEW)
  serialNumbers      String[]          // for fixed assets, one entry per unit received

  @@map("inventory_goods_receipt_lines")
}

model InventoryAllocation {
  id                String             @id @default(uuid())
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem      @relation(fields: [itemId], references: [id])
  quantity          Int                @default(1)   // >1 only for consumables issued in bulk
  requestId         String?
  request           InventoryRequest?  @relation(fields: [requestId], references: [id])

  custodianType     CustodianType
  custodianUserId   String?            // STAFF or STUDENT
  custodianUser     User?              @relation("CustodianOf", fields: [custodianUserId], references: [id])
  custodianRoomId   String?            // ROOM
  custodianRoom     InventoryLocation? @relation(fields: [custodianRoomId], references: [id])
  custodianLabel    String?            // DEPARTMENT / CLASS free text

  issuedById        String
  issuedBy          User               @relation("IssuedAllocations", fields: [issuedById], references: [id])
  issuedAt          DateTime           @default(now())
  dueBackAt         DateTime?
  returnedAt        DateTime?
  conditionAtIssue  ItemCondition
  conditionAtReturn ItemCondition?
  status            AllocationStatus   @default(ACTIVE)
  notes             String?

  @@index([schoolId, status])
  @@index([itemId])
  @@map("inventory_allocations")
}

model InventoryMovement {
  id                   String             @id @default(uuid())
  schoolId             String
  school               School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId               String
  item                 InventoryItem      @relation(fields: [itemId], references: [id])
  type                 MovementType
  quantity             Int                @default(1)
  fromLocationId       String?
  fromLocation         InventoryLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocationId         String?
  toLocation           InventoryLocation? @relation("MovementTo", fields: [toLocationId], references: [id])
  performedById        String
  performedBy          User               @relation(fields: [performedById], references: [id])
  relatedAllocationId  String?
  relatedMaintenanceId String?
  note                 String?
  createdAt            DateTime           @default(now())

  @@index([schoolId, itemId])
  @@index([schoolId, type])
  @@map("inventory_movements")
}

model MaintenanceRecord {
  id                String            @id @default(uuid())
  schoolId          String
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem     @relation(fields: [itemId], references: [id])
  reportedById      String
  reportedBy        User              @relation("ReportedMaintenance", fields: [reportedById], references: [id])
  faultDescription  String
  status            MaintenanceStatus @default(REPORTED)
  assignedToStaffId String?
  assignedToStaff   User?             @relation("AssignedMaintenance", fields: [assignedToStaffId], references: [id])
  externalVendor    String?
  cost              Float?
  reportedAt        DateTime          @default(now())
  resolvedAt        DateTime?
  resolutionNotes   String?

  @@index([schoolId, status])
  @@map("inventory_maintenance_records")
}

model DisposalRecord {
  id                  String          @id @default(uuid())
  schoolId            String
  school              School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId              String
  item                InventoryItem   @relation(fields: [itemId], references: [id])
  reason              DisposalReason
  method              String?         // "auction", "e-waste recycler", "donated to X", etc.
  approvedById        String
  approvedBy          User            @relation(fields: [approvedById], references: [id])
  bookValueAtDisposal Float?
  saleValue           Float?
  disposedAt          DateTime        @default(now())
  notes               String?

  @@index([schoolId])
  @@map("inventory_disposal_records")
}

model StockCount {
  id          String             @id @default(uuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String             // "Q3 2026 Full Stock Take", "Chemistry Lab Cycle Count"
  locationId  String?            // null = whole-school count
  location    InventoryLocation? @relation(fields: [locationId], references: [id])
  startedById String
  startedBy   User               @relation(fields: [startedById], references: [id])
  status      String             @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  lines       StockCountLine[]

  @@index([schoolId])
  @@map("inventory_stock_counts")
}

model StockCountLine {
  id           String        @id @default(uuid())
  stockCountId String
  stockCount   StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id])
  expectedQty  Int
  countedQty   Int?
  variance     Int?
  notes        String?

  @@map("inventory_stock_count_lines")
}





