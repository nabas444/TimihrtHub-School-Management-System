// ─────────────────────────────────────────────────────────────────────────────
// TimhirtHub — Full Prisma Schema
// TimhirtHub Platform: Students · Teachers · Parents · Admins
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  PARENT
  FINANCE
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SubscriptionPlan {
  FREE
  BASIC
  STANDARD
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum ExamType {
  QUIZ
  MID_TERM
  FINAL
  MOCK
  STANDARDIZED
}

enum BehaviourType {
  MERIT
  DEMERIT
  INCIDENT
  COMMENDATION
  WARNING
  SUSPENSION
}

enum BehaviourSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnnouncementTarget {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  CLASS
  GRADE_LEVEL
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  SYSTEM
}

enum RoomType {
  DIRECT
  GROUP
  CLASS
  STAFF
  ANNOUNCEMENT
}

enum FeeType {
  TUITION
  EXAM
  LIBRARY
  TRANSPORT
  UNIFORM
  ACTIVITY
  BOARDING
  OTHER
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BookStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
}

enum NotificationType {
  GRADE
  ASSIGNMENT
  EXAM
  ATTENDANCE
  BEHAVIOUR
  ANNOUNCEMENT
  CHAT
  FEE
  MEETING
  ANNUAL_PLAN
  GENERAL
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnualPlanScope {
  TEACHER_SUBJECT
  SCHOOL_WIDE
}

enum AnnualPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ARCHIVE
}

enum CertificateType {
  GRADUATION
  RECOGNITION
}

enum CertificateRecipientType {
  STUDENT
  STAFF
}

enum SupportProgramType {
  FINANCIAL_AID
  MEAL_SUPPORT
  SCHOLARSHIP
  OTHER
}

enum SupportEnrollmentStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum ProgramType {
  REGULAR
  SUMMER
  NIGHT
  WEEKEND
  EXTENSION
  OTHER
}

enum TutorialEnrollmentStatus {
  ENROLLED
  WAITLISTED
  DROPPED
}

enum MilestoneType {
  NONE
  EXTERNAL_EXAM
  CEREMONY
}

enum ExternalExamRegistrationStatus {
  NOT_REGISTERED
  REGISTERED
  SAT
  ABSENT
  RESULT_PENDING
  RESULT_RECORDED
}

enum CeremonyType {
  GRADUATION
  COMPLETION
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
  VOLUNTEER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FILLED
  CANCELLED
}

enum PostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewFormat {
  IN_PERSON
  ONLINE
  PHONE
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  HOLD
  NO_HIRE
  STRONG_NO_HIRE
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingItemStatus {
  PENDING
  COMPLETED
  WAIVED
}

enum EmployeeDocumentType {
  CONTRACT
  ID_CARD
  DEGREE_DIPLOMA
  TEACHING_LICENSE
  WORK_PERMIT
  POLICE_CLEARANCE
  MEDICAL_REPORT
  RESUME
  CERTIFICATE
  OTHER
}

enum StaffDisciplinaryType {
  VERBAL_WARNING
  WRITTEN_WARNING
  SUSPENSION
  INQUIRY
  COMMENDATION
  OTHER
}

enum OffboardingStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHOOL (Tenant root — every record belongs to a school)
// ─────────────────────────────────────────────────────────────────────────────

model School {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique // used in subdomain routing
  logo          String?
  address       String?
  city          String?
  country       String   @default("Ethiopia")
  phone         String?
  email         String?
  website       String?
  timezone      String   @default("Africa/Addis_Ababa")
  academicYear  String   @default("2024/2025")
  termSystem    String   @default("SEMESTER") // SEMESTER | TRIMESTER | QUARTER
  gradingSystem String   @default("PERCENTAGE") // PERCENTAGE | GPA | LETTER
  maxStudents   Int      @default(500)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscription  Subscription?
  users         User[]
  classes       Class[]
  subjects      Subject[]
  academicTerms AcademicTerm[]
  announcements Announcement[]
  chatRooms     ChatRoom[]
  feeTemplates  FeeTemplate[]
  feeInvoices   FeeInvoice[]
  libraryBooks  LibraryBook[]
  events        SchoolEvent[]
  files         File[]
  notifications Notification[]
  gradeLevels   GradeLevel[]
  busRoutes     BusRoute[]
  settings      SchoolSettings?
  lookupValues  LookupValue[]
  certificates  Certificate[]
  annualPlans   AnnualPlan[]
  supportPrograms SupportProgram[]
  tutorialSessions TutorialSession[]
  externalExamCheckpoints ExternalExamCheckpoint[]
  ceremonyEvents CeremonyEvent[]

  // HR & Recruiting
  employees             Employee[]
  jobRequisitions       JobRequisition[]
  jobPostings           JobPosting[]
  jobApplications       JobApplication[]
  jobInterviews         JobInterview[]
  jobOffers             JobOffer[]
  onboardingChecklists  OnboardingChecklist[]
  employeeDocuments     EmployeeDocument[]
  performanceReviews    PerformanceReview[]
  staffTrainings        StaffTraining[]
  staffDisciplinaryRecords StaffDisciplinaryRecord[]
  offboardingRecords    OffboardingRecord[]

  @@map("schools")
}

model SchoolSettings {
  id                   String  @id @default(uuid())
  schoolId             String  @unique
  allowParentChat      Boolean @default(true)
  allowStudentChat     Boolean @default(true)
  attendanceStartTime  String  @default("08:00")
  attendanceCutoffTime String  @default("09:00")
  lateThresholdMinutes Int     @default(15)
  passMarkPercentage   Int     @default(50)
  enableAiFeatures     Boolean @default(true)
  enableLibrary        Boolean @default(true)
  enableTransport      Boolean @default(false)
  primaryColor         String  @default("#4F46E5")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTION & BILLING
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid())
  schoolId             String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String    @id @default(uuid())
  subscriptionId  String
  amount          Float
  currency        String    @default("USD")
  status          String // succeeded | failed | pending
  stripePaymentId String?   @unique
  invoiceUrl      String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS (all 4 roles in one table, role-specific profiles separate)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  schoolId         String
  role             Role
  email            String
  password         String
  firstName        String
  middleName       String?
  lastName         String
  phone            String?
  avatar           String?
  gender           Gender?
  dateOfBirth      DateTime?
  address          String?
  nationality      String?
  city             String?
  state            String?
  pincode          String?
  birthPlace       String?
  emergencyContact String?
  emergencyPhone   String?
  isActive         Boolean   @default(true)
  isEmailVerified  Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Phase 5 (SMS Notification Channel): opt-in, not on by default, so a
  // parent must explicitly choose to receive absence/fee-due alerts by SMS
  // in addition to the existing in-app/push notifications.
  smsOptIn Boolean @default(false)

  // Auth tokens
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  // Role-specific profiles
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
  adminProfile   AdminProfile?

  // Academic
  createdAssignments Assignment[]       @relation("AssignmentCreator")
  submissions        Submission[]       @relation("StudentSubmissions")
  gradedSubmissions  Submission[]       @relation("GradedBy")
  attendanceRecords  AttendanceRecord[] @relation("StudentAttendance")
  markedAttendance   AttendanceRecord[] @relation("TeacherAttendance")
  behaviourRecords   BehaviourRecord[]  @relation("StudentBehaviour")
  behaviourReports   BehaviourRecord[]  @relation("TeacherReports")

  // Communication
  sentMessages      Message[]      @relation("MessageSender")
  notifications     Notification[]
  announcements     Announcement[] @relation("AnnouncementAuthor")
  meetingsAsTeacher Meeting[]      @relation("TeacherMeetings")
  meetingsAsParent  Meeting[]      @relation("ParentMeetings")
  uploadedFiles     File[]

  // Certificates
  receivedCertificates Certificate[] @relation("CertificateRecipient")
  signedCertificates   Certificate[] @relation("CertificateSigner")

  // Annual Plans
  createdAnnualPlans  AnnualPlan[] @relation("AnnualPlanCreator")
  reviewedAnnualPlans AnnualPlan[] @relation("AnnualPlanReviewer")

  // Student Support
  approvedSupportEnrollments StudentSupportEnrollment[] @relation("SupportEnrollmentApprover")

  // External Exam Records
  externalExamRecordsRecorded ExternalExamRecord[] @relation("ExternalExamRecorder")

  // HR & Recruiting
  employeeProfile             Employee?
  requestedRequisitions       JobRequisition[]      @relation("RequisitionRequester")
  approvedRequisitions        JobRequisition[]      @relation("RequisitionApprover")
  interviews                  JobInterview[]        @relation("InterviewInterviewer")
  interviewFeedbacks          InterviewFeedback[]   @relation("FeedbackInterviewer")
  performanceReviewsAuthored  PerformanceReview[]   @relation("PerformanceReviewer")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, email])
  @@index([schoolId, role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLE PROFILES
// ─────────────────────────────────────────────────────────────────────────────

model StudentProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  admissionNumber   String
  rollNumber        String?
  classId           String?
  gradeLevelId      String?
  bloodGroup        String?
  medicalNotes      String?
  enrolledAt        DateTime      @default(now())
  graduatedAt       DateTime?
  busRouteId        String?
  usesTransport     Boolean?
  programType       ProgramType?
  programTypeLabel  String?
  status            StudentStatus @default(ACTIVE)

  middleName        String?
  fatherFirstName   String?
  fatherMiddleName  String?
  fatherLastName    String?
  motherFirstName   String?
  motherMiddleName  String?
  motherLastName    String?
  fatherMobile      String?
  motherMobile      String?
  landline          String?
  nationality       String?
  city              String?
  state             String?
  pincode           String?
  birthPlace        String?
  religionId        String?
  categoryId        String?
  feeCategoryId     String?
  sourceId          String?
  houseId           String?
  curriculumId      String?
  previousSchoolId  String?
  previousClassYear String?
  reference         String?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  class             Class?              @relation(fields: [classId], references: [id])
  gradeLevel        GradeLevel?         @relation(fields: [gradeLevelId], references: [id])
  parentLinks       ParentStudentLink[]
  busRoute          BusRoute?           @relation(fields: [busRouteId], references: [id])
  feeInvoices       FeeInvoice[]
  libraryIssues     LibraryIssue[]
  aiInsights        AiInsight[]
  ExamResult        ExamResult[]
  GradeReport       GradeReport[]

  religion          LookupValue?        @relation("StudentReligion", fields: [religionId], references: [id])
  category          LookupValue?        @relation("StudentCategory", fields: [categoryId], references: [id])
  feeCategory       LookupValue?        @relation("StudentFeeCategory", fields: [feeCategoryId], references: [id])
  source            LookupValue?        @relation("StudentSource", fields: [sourceId], references: [id])
  house             LookupValue?        @relation("StudentHouse", fields: [houseId], references: [id])
  curriculum        LookupValue?        @relation("StudentCurriculum", fields: [curriculumId], references: [id])
  previousSchool    LookupValue?        @relation("StudentPreviousSchool", fields: [previousSchoolId], references: [id])

  installmentPlans      InstallmentPlan[]
  academicYearSummaries AcademicYearSummary[]
  certificates          Certificate[]
  supportEnrollments    StudentSupportEnrollment[]
  tutorialEnrollments   TutorialEnrollment[]
  externalExamRecords   ExternalExamRecord[]
  ceremonyParticipants  CeremonyParticipant[]

  @@map("student_profiles")
}

model TeacherProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  employeeId       String
  qualification    String?
  specialization   String?
  designation      String?
  experienceYears  Int?
  joinedAt         DateTime @default(now())
  isClassTeacher   Boolean  @default(false)
  classTeacherOfId String?
  gradeLevelId     String?
  religionId       String?
  houseId          String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Single class this teacher is class-teacher of
  classTeacherOf   Class?            @relation("ClassTeacher", fields: [classTeacherOfId], references: [id])
  // Classes this teacher has been assigned to (many-to-many)
  assignedClasses  Class[]           @relation("AssignedClasses")
  gradeLevel       GradeLevel?       @relation("TeacherGradeLevel", fields: [gradeLevelId], references: [id])
  subjectTeachings SubjectTeaching[]
  leaveRequests    LeaveRequest[]
  payrollRecords   PayrollRecord[]
  annualPlans      AnnualPlan[]
  tutorialSessions TutorialSession[]

  religion         LookupValue?      @relation("TeacherReligion", fields: [religionId], references: [id])
  house            LookupValue?      @relation("TeacherHouse", fields: [houseId], references: [id])

  @@map("teacher_profiles")
}

model ParentProfile {
  id           String              @id @default(uuid())
  userId       String              @unique
  occupation   String?
  relation     String? // Father | Mother | Guardian
  annualIncome String?
  education    String?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks ParentStudentLink[]

  @@map("parent_profiles")
}

model AdminProfile {
  id           String       @id @default(uuid())
  userId       String       @unique
  employeeId   String?
  department   String?
  designation  String?
  joinedAt     DateTime     @default(now())
  isSuperAdmin Boolean      @default(false)
  religionId   String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  religion     LookupValue? @relation("AdminReligion", fields: [religionId], references: [id])

  @@map("admin_profiles")
}

model ParentStudentLink {
  id               String   @id @default(uuid())
  parentProfileId  String
  studentProfileId String
  relation         String   @default("Guardian")
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  parentProfile  ParentProfile  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([parentProfileId, studentProfileId])
  @@map("parent_student_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model GradeLevel {
  id            String        @id @default(uuid())
  schoolId      String
  name          String // Grade 1, Grade 10, Form 3, etc.
  level         Int // numeric order
  milestoneType MilestoneType @default(NONE)
  createdAt     DateTime      @default(now())

  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes                 Class[]
  subjects                Subject[]
  students                StudentProfile[]
  exams                   Exam[]
  teachers                TeacherProfile[]         @relation("TeacherGradeLevel")
  announcements           Announcement[]
  tutorialSessions        TutorialSession[]
  externalExamCheckpoints ExternalExamCheckpoint[]
  ceremonyEvents          CeremonyEvent[]

  @@unique([schoolId, level])
  @@map("grade_levels")
}

model Class {
  id               String      @id @default(uuid())
  schoolId         String
  gradeLevelId     String
  name             String // 10A, 10B, Form 3 Science, etc.
  academicYear     String
  capacity         Int         @default(40)
  room             String?
  programType      ProgramType @default(REGULAR)
  programTypeLabel String?
  createdAt        DateTime    @default(now())

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel        GradeLevel         @relation(fields: [gradeLevelId], references: [id])
  students          StudentProfile[]
  classTeacher      TeacherProfile[]   @relation("ClassTeacher")
  // Teachers assigned to this class (many-to-many)
  assignedTeachers  TeacherProfile[]   @relation("AssignedClasses")
  teachings         SubjectTeaching[]
  timetableSlots    TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  announcements     Announcement[]
  chatRoom          ChatRoom?          @relation("ClassChatRoom")
  exams             Exam[]
  tutorialSessions  TutorialSession[]

  @@unique([schoolId, name, academicYear])
  @@map("classes")
}

model AcademicTerm {
  id           String   @id @default(uuid())
  schoolId     String
  name         String // Semester 1, Term 2, Q1
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  exams             Exam[]
  attendanceRecords AttendanceRecord[]
  gradeReports      GradeReport[]

  @@map("academic_terms")
}

model Subject {
  id           String   @id @default(uuid())
  schoolId     String
  gradeLevelId String?
  name         String
  code         String
  description  String?
  creditHours  Int      @default(3)
  isCore       Boolean  @default(true)
  createdAt    DateTime @default(now())

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel       GradeLevel?       @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  teachings        SubjectTeaching[]
  assignments      Assignment[]
  exams            Exam[]
  annualPlans      AnnualPlan[]
  tutorialSessions TutorialSession[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model SubjectTeaching {
  id               String @id @default(uuid())
  classId          String
  subjectId        String
  teacherProfileId String
  academicYear     String

  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile  @relation(fields: [teacherProfileId], references: [id])
  timetableSlots TimetableSlot[]

  @@unique([classId, subjectId, academicYear])
  @@map("subject_teachings")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────────

model TimetableSlot {
  id                String    @id @default(uuid())
  classId           String
  subjectTeachingId String
  dayOfWeek         DayOfWeek
  startTime         String // "08:00"
  endTime           String // "09:00"
  room              String?
  academicYear      String

  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectTeaching SubjectTeaching @relation(fields: [subjectTeachingId], references: [id])

  @@map("timetable_slots")
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSIGNMENTS & HOMEWORK
// ─────────────────────────────────────────────────────────────────────────────

model Assignment {
  id           String   @id @default(uuid())
  schoolId     String
  subjectId    String
  classId      String? // null = all classes for this subject
  termId       String
  createdById  String
  title        String
  description  String?
  instructions String?
  type         String   @default("HOMEWORK") // HOMEWORK | PROJECT | LAB | ESSAY
  totalMarks   Float    @default(100)
  passingMarks Float    @default(50)
  dueDate      DateTime
  isPublished  Boolean  @default(false)
  allowLate    Boolean  @default(false)
  attachments  String[] @default([]) // S3 URLs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id])
  term          AcademicTerm   @relation(fields: [termId], references: [id])
  createdBy     User           @relation("AssignmentCreator", fields: [createdById], references: [id])
  submissions   Submission[]
  notifications Notification[]

  @@map("assignments")
}

model Submission {
  id            String           @id @default(uuid())
  assignmentId  String
  studentId     String // User.id
  status        SubmissionStatus @default(PENDING)
  content       String?
  attachments   String[]         @default([])
  submittedAt   DateTime?
  marksObtained Float?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id])
  gradedBy   User?      @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAMS & RESULTS
// ─────────────────────────────────────────────────────────────────────────────

model Exam {
  id           String   @id @default(uuid())
  schoolId     String
  subjectId    String
  classId      String?
  gradeLevelId String?
  termId       String
  title        String
  examType     ExamType @default(MID_TERM)
  totalMarks   Float    @default(100)
  passingMarks Float    @default(50)
  duration     Int // minutes
  scheduledAt  DateTime
  venue        String?
  instructions String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject    Subject      @relation(fields: [subjectId], references: [id])
  class      Class?       @relation(fields: [classId], references: [id])
  gradeLevel GradeLevel?  @relation(fields: [gradeLevelId], references: [id])
  term       AcademicTerm @relation(fields: [termId], references: [id])
  results    ExamResult[]

  @@map("exams")
}

model ExamResult {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Float
  grade         String? // A, B, C, F — computed
  remarks       String?
  isAbsent      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@map("exam_results")
}

model GradeReport {
  id             String    @id @default(uuid())
  studentId      String
  termId         String
  classId        String
  gpa            Float?
  totalMarks     Float?
  percentage     Float?
  rank           Int?
  remarks        String?
  teacherComment String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])
  term    AcademicTerm   @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@map("grade_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceRecord {
  id         String           @id @default(uuid())
  schoolId   String
  studentId  String // User.id
  classId    String
  termId     String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(ABSENT)
  note       String?
  markedById String // Teacher User.id
  markedAt   DateTime         @default(now())

  student  User         @relation("StudentAttendance", fields: [studentId], references: [id])
  class    Class        @relation(fields: [classId], references: [id])
  term     AcademicTerm @relation(fields: [termId], references: [id])
  markedBy User         @relation("TeacherAttendance", fields: [markedById], references: [id])

  @@unique([studentId, classId, date])
  @@index([schoolId, date])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// BEHAVIOUR TRACKING
// ─────────────────────────────────────────────────────────────────────────────

model BehaviourRecord {
  id             String            @id @default(uuid())
  schoolId       String
  studentId      String // User.id
  reportedById   String // Teacher User.id
  type           BehaviourType
  severity       BehaviourSeverity @default(LOW)
  title          String
  description    String
  actionTaken    String?
  points         Int               @default(0) // +ve merit, -ve demerit
  date           DateTime
  isResolved     Boolean           @default(false)
  parentNotified Boolean           @default(false)
  attachments    String[]          @default([])
  createdAt      DateTime          @default(now())

  student    User @relation("StudentBehaviour", fields: [studentId], references: [id])
  reportedBy User @relation("TeacherReports", fields: [reportedById], references: [id])

  @@index([schoolId, studentId])
  @@map("behaviour_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT & MESSAGING
// ─────────────────────────────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(uuid())
  schoolId  String
  name      String?
  type      RoomType @default(DIRECT)
  classId   String?  @unique // for CLASS rooms
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class?           @relation("ClassChatRoom", fields: [classId], references: [id])
  members  ChatRoomMember[]
  messages Message[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("chat_room_members")
}

model Message {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String
  type      MessageType @default(TEXT)
  content   String?
  fileUrl   String?
  fileName  String?
  isEdited  Boolean     @default(false)
  isDeleted Boolean     @default(false)
  replyToId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  room      ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User              @relation("MessageSender", fields: [senderId], references: [id])
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]         @relation("MessageReplies")
  reactions MessageReaction[]

  @@index([roomId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String
  authorId    String
  classId     String? // if target = CLASS (single class legacy / primary)
  classIds    String[]             @default([]) // multi-class targeting
  gradeLevelId String?             // if target = GRADE_LEVEL or for cascading
  title       String
  content     String
  target      AnnouncementTarget   @default(ALL)
  priority    AnnouncementPriority @default(NORMAL)
  isPinned    Boolean              @default(false)
  attachments String[]             @default([])
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author     User        @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  class      Class?      @relation(fields: [classId], references: [id])
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id])

  @@index([schoolId, publishedAt])
  @@map("announcements")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEETINGS (Parent-Teacher)
// ─────────────────────────────────────────────────────────────────────────────

model Meeting {
  id          String        @id @default(uuid())
  schoolId    String
  teacherId   String // User.id
  parentId    String // User.id
  studentId   String?
  title       String
  agenda      String?
  scheduledAt DateTime
  duration    Int           @default(30) // minutes
  location    String? // room or "Online"
  meetingLink String?
  status      MeetingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teacher User @relation("TeacherMeetings", fields: [teacherId], references: [id])
  parent  User @relation("ParentMeetings", fields: [parentId], references: [id])

  @@index([schoolId, scheduledAt])
  @@map("meetings")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEES & FINANCE
// ─────────────────────────────────────────────────────────────────────────────

model FeeTemplate {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  type        FeeType  @default(TUITION)
  amount      Float
  dueDay      Int      @default(1) // day of month
  termBased   Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("fee_templates")
}

model FeeInvoice {
  id               String            @id @default(uuid())
  schoolId         String
  studentProfileId String
  title            String
  type             FeeType           @default(TUITION)
  amount           Float
  paidAmount       Float             @default(0)
  discount         Float             @default(0)
  discountType     String            @default("AMOUNT") // "AMOUNT" | "PERCENT"
  taxRate          Float             @default(0) // percent
  taxAmount        Float             @default(0) // computed tax amount
  dueDate          DateTime
  status           FeeStatus         @default(PENDING)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id])
  feePayments      FeePayment[]
  installmentPlans InstallmentPlan[]

  @@index([schoolId, status])
  @@map("fee_invoices")
}

model FeePayment {
  id                 String   @id @default(uuid())
  invoiceId          String
  amount             Float
  method             String // CASH | BANK_TRANSFER | STRIPE | MPESA
  reference          String?
  stripePaymentId    String?
  paidAt             DateTime @default(now())
  receipt            String?
  provisionalReceipt String? // draft/pre-receipt reference before final save
  receiptCopies      Int      @default(1) // 1 = single receipt, 2 = double (school + parent)

  invoice            FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("fee_payments")
}

model InstallmentPlan {
  id               String   @id @default(uuid())
  studentProfileId String
  invoiceId        String?
  totalAmount      Float
  numInstallments  Int
  taxRate          Float    @default(0)
  discount         Float    @default(0)
  createdAt        DateTime @default(now())

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  invoice          FeeInvoice?    @relation(fields: [invoiceId], references: [id])
  installments     Installment[]

  @@map("installment_plans")
}

model Installment {
  id             String    @id @default(uuid())
  planId         String
  installmentNo  Int
  dueDate        DateTime
  amount         Float
  tax            Float     @default(0)
  total          Float
  payDate        DateTime?
  payAmount      Float?
  receiptNo      String?
  noCarryForward Boolean   @default(false)

  plan           InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("installments")
}

model LookupValue {
  id       String  @id @default(uuid())
  schoolId String
  type     String // "RELIGION" | "CATEGORY" | "FEE_CATEGORY" | "SOURCE" | "HOUSE" | "CURRICULUM" | "PREVIOUS_SCHOOL"
  value    String
  colorHex String? // For HOUSE strip color or badge tags
  isActive Boolean @default(true)

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentReligions       StudentProfile[] @relation("StudentReligion")
  studentCategories      StudentProfile[] @relation("StudentCategory")
  studentFeeCategories   StudentProfile[] @relation("StudentFeeCategory")
  studentSources         StudentProfile[] @relation("StudentSource")
  studentHouses          StudentProfile[] @relation("StudentHouse")
  studentCurriculums     StudentProfile[] @relation("StudentCurriculum")
  studentPreviousSchools StudentProfile[] @relation("StudentPreviousSchool")

  teacherReligions       TeacherProfile[] @relation("TeacherReligion")
  teacherHouses          TeacherProfile[] @relation("TeacherHouse")
  adminReligions         AdminProfile[]   @relation("AdminReligion")

  // HR & Recruiting
  employeeDepartments    Employee[]       @relation("EmployeeDepartment")
  employeePositions      Employee[]       @relation("EmployeePosition")
  requisitionDepartments JobRequisition[] @relation("RequisitionDepartment")
  requisitionPositions   JobRequisition[] @relation("RequisitionPosition")
  postingDepartments     JobPosting[]     @relation("PostingDepartment")
  postingPositions       JobPosting[]     @relation("PostingPosition")

  @@index([schoolId, type])
  @@map("lookup_values")
}

// ─────────────────────────────────────────────────────────────────────────────
// LIBRARY
// ─────────────────────────────────────────────────────────────────────────────

model LibraryBook {
  id                String     @id @default(uuid())
  schoolId          String
  title             String
  author            String
  isbn              String?
  edition           String?
  language          String?
  description       String?
  category          String
  tags              String[]   @default([])
  publisher         String?
  year              Int?
  copies            Int        @default(1)
  available         Int        @default(1)
  condition         String?
  acquisitionSource String?
  price             Float?
  digitalCopyUrl    String?
  barcodeNumber     String?
  status            BookStatus @default(AVAILABLE)
  coverUrl          String?
  location          String? // shelf reference
  createdAt         DateTime   @default(now())

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues LibraryIssue[]

  @@map("library_books")
}

model LibraryIssue {
  id               String    @id @default(uuid())
  bookId           String
  studentProfileId String
  issuedAt         DateTime  @default(now())
  dueDate          DateTime
  returnedAt       DateTime?
  fine             Float     @default(0)
  finePaid         Boolean   @default(false)
  notes            String?

  book           LibraryBook    @relation(fields: [bookId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("library_issues")
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF (HR, Leave, Payroll)
// ─────────────────────────────────────────────────────────────────────────────

model LeaveRequest {
  id               String          @id @default(uuid())
  teacherProfileId String?
  employeeId       String?
  type             String // SICK | ANNUAL | MATERNITY | UNPAID
  startDate        DateTime
  endDate          DateTime
  reason           String
  status           LeaveStatus     @default(PENDING)
  approvedById     String?
  approvedAt       DateTime?
  documents        String[]        @default([])
  createdAt        DateTime        @default(now())

  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  employee         Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("leave_requests")
}

model PayrollRecord {
  id               String          @id @default(uuid())
  teacherProfileId String?
  employeeId       String?
  month            Int
  year             Int
  baseSalary       Float
  allowances       Float           @default(0)
  deductions       Float           @default(0)
  netPay           Float
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime        @default(now())

  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  employee         Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, month, year])
  @@index([employeeId, month, year])
  @@map("payroll_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// FILES & RESOURCES
// ─────────────────────────────────────────────────────────────────────────────

model File {
  id           String   @id @default(uuid())
  schoolId     String
  uploadedById String
  name         String
  url          String
  size         Int
  mimeType     String
  category     String? // SYLLABUS | RESOURCE | REPORT | OTHER
  classId      String?
  subjectId    String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@map("files")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────────────────────────────────────

model SchoolEvent {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  type        String    @default("GENERAL") // HOLIDAY | EXAM | SPORTS | CULTURAL | GENERAL
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id           String           @id @default(uuid())
  schoolId     String
  userId       String
  type         NotificationType
  title        String
  body         String
  data         Json? // extra payload (assignmentId, examId, etc.)
  isRead       Boolean          @default(false)
  readAt       DateTime?
  assignmentId String?
  createdAt    DateTime         @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI INSIGHTS
// ─────────────────────────────────────────────────────────────────────────────

model AiInsight {
  id               String   @id @default(uuid())
  studentProfileId String
  type             String // PERFORMANCE | RISK | RECOMMENDATION | SUMMARY
  title            String
  content          String
  score            Float?
  riskLevel        String? // LOW | MEDIUM | HIGH
  metadata         Json?
  generatedAt      DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSPORT
// ─────────────────────────────────────────────────────────────────────────────

model BusRoute {
  id          String  @id @default(uuid())
  schoolId    String
  name        String
  description String?
  driver      String?
  driverPhone String?
  capacity    Int     @default(40)
  isActive    Boolean @default(true)

  students StudentProfile[]
  School   School           @relation(fields: [schoolId], references: [id])

  @@map("bus_routes")
}

// Relations added to ExamResult
// (added inline above: ExamResult -> StudentProfile)

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC YEAR SUMMARIES & CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

model AcademicYearSummary {
  id                String   @id @default(uuid())
  studentProfileId  String
  academicYear      String
  classId           String
  overallAverage    Float?
  overallRank       Int?
  termBreakdown     Json     // [{ termId, termName, gpa, percentage, rank }, ...] — snapshot at generation time
  isPassing         Boolean  @default(false)
  isPublished       Boolean  @default(false)
  publishedAt       DateTime?
  generatedAt       DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([studentProfileId, academicYear])
  @@map("academic_year_summaries")
}

model Certificate {
  id               String                    @id @default(uuid())
  schoolId         String
  type             CertificateType
  recipientType    CertificateRecipientType
  studentProfileId String?                   // set when recipientType = STUDENT
  userId           String?                   // set when recipientType = STAFF (TEACHER/ADMIN/etc. user)
  academicYear     String?                   // relevant mainly for GRADUATION
  title            String                    // e.g. "Certificate of Academic Excellence"
  reason           String?                   // free text: criteria/achievement description
  issueDate        DateTime                  @default(now())
  layout           String                    @default("ONE_SIDED") // "ONE_SIDED" | "TWO_SIDED"
  signedById       String?                   // e.g. principal/admin issuing signature
  createdAt        DateTime                  @default(now())

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  user           User?           @relation("CertificateRecipient", fields: [userId], references: [id])
  signedBy       User?           @relation("CertificateSigner", fields: [signedById], references: [id])
  ceremonyParticipants CeremonyParticipant[]

  @@index([schoolId, type])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNUAL PLANS (Teacher Scheme of Work & School-wide Plans)
// ─────────────────────────────────────────────────────────────────────────────

model AnnualPlan {
  id               String            @id @default(uuid())
  schoolId         String
  scope            AnnualPlanScope
  createdById      String            // User.id — the teacher or admin who authored it
  teacherProfileId String?           // set when scope = TEACHER_SUBJECT
  subjectId        String?           // set when scope = TEACHER_SUBJECT
  classId          String?           // optional — plan may be class-specific or apply across all classes for that subject
  gradeLevelId     String?           // for SCHOOL_WIDE plans scoped to a grade level, optional
  academicYear     String
  title            String
  columns          Json              // array of column header labels, e.g. ["Term","Topic","Objectives","Activities","Resources","Assessment","Weeks"]
  rows             Json              // array of row objects/arrays matching the columns
  status           AnnualPlanStatus  @default(DRAFT)
  submittedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("AnnualPlanCreator", fields: [createdById], references: [id])
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  reviewedBy     User?           @relation("AnnualPlanReviewer", fields: [reviewedById], references: [id])

  @@index([schoolId, academicYear])
  @@map("annual_plans")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT SUPPORT PROGRAMS & WELFARE
// ─────────────────────────────────────────────────────────────────────────────

model SupportProgram {
  id            String             @id @default(uuid())
  schoolId      String
  type          SupportProgramType
  name          String
  description   String?
  waiverPercent Float? // 0-100, for FINANCIAL_AID/SCHOLARSHIP types — % of tuition fees waived while active; null = no automatic fee effect
  academicYear  String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments StudentSupportEnrollment[]

  @@index([schoolId, type])
  @@map("support_programs")
}

model StudentSupportEnrollment {
  id               String                  @id @default(uuid())
  studentProfileId String
  supportProgramId String
  status           SupportEnrollmentStatus @default(ACTIVE)
  startDate        DateTime                @default(now())
  endDate          DateTime?
  notes            String? // confidential — visibility restricted to admin/finance
  approvedById     String // User.id, admin/finance who approved
  createdAt        DateTime                @default(now())

  studentProfile          StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  supportProgram          SupportProgram           @relation(fields: [supportProgramId], references: [id])
  approvedBy              User                     @relation("SupportEnrollmentApprover", fields: [approvedById], references: [id])
  mealDistributionRecords MealDistributionRecord[]

  @@index([studentProfileId])
  @@map("student_support_enrollments")
}

model MealDistributionRecord {
  id                         String   @id @default(uuid())
  studentSupportEnrollmentId String
  date                       DateTime @db.Date
  recordedById               String // User.id, staff who logged distribution
  notes                      String?

  enrollment StudentSupportEnrollment @relation(fields: [studentSupportEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([studentSupportEnrollmentId, date])
  @@map("meal_distribution_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// TUTORIALS & EXTRA LECTURE SESSIONS
// ─────────────────────────────────────────────────────────────────────────────

model TutorialSession {
  id               String      @id @default(uuid())
  schoolId         String
  title            String
  subjectId        String?
  classId          String? // optional — target single class or open across grade/subject
  gradeLevelId     String?
  teacherProfileId String
  dayOfWeek        DayOfWeek? // set for recurring weekly sessions
  specificDate     DateTime? // set for one-off sessions instead of a recurring day
  startTime        String // "16:00"
  endTime          String // "17:30"
  location         String?
  capacity         Int?
  isRecurring      Boolean     @default(true)
  academicYear     String
  createdAt        DateTime    @default(now())

  school         School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject?                   @relation(fields: [subjectId], references: [id])
  class          Class?                     @relation(fields: [classId], references: [id])
  gradeLevel     GradeLevel?                @relation(fields: [gradeLevelId], references: [id])
  teacherProfile TeacherProfile             @relation(fields: [teacherProfileId], references: [id])
  enrollments    TutorialEnrollment[]
  attendance     TutorialAttendanceRecord[]

  @@index([schoolId, academicYear])
  @@map("tutorial_sessions")
}

model TutorialEnrollment {
  id                String                   @id @default(uuid())
  tutorialSessionId String
  studentProfileId  String
  status            TutorialEnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime                 @default(now())

  tutorialSession TutorialSession @relation(fields: [tutorialSessionId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorialSessionId, studentProfileId])
  @@map("tutorial_enrollments")
}

model TutorialAttendanceRecord {
  id                String           @id @default(uuid())
  tutorialSessionId String
  studentProfileId  String
  date              DateTime         @db.Date
  status            AttendanceStatus @default(ABSENT)
  markedById        String

  tutorialSession TutorialSession @relation(fields: [tutorialSessionId], references: [id], onDelete: Cascade)

  @@unique([tutorialSessionId, studentProfileId, date])
  @@map("tutorial_attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTERNAL EXAM CHECKPOINTS & RECORDS (Regional / National Exams)
// ─────────────────────────────────────────────────────────────────────────────

model ExternalExamCheckpoint {
  id                String   @id @default(uuid())
  schoolId          String
  gradeLevelId      String
  academicYear      String
  name              String    // e.g. "Grade 6 Regional Examination", "ESSLCE / University Entrance Examination"
  administeringBody String?   // e.g. "Regional Education Bureau", "EAES"
  examWindowStart   DateTime?
  examWindowEnd     DateTime?
  passCutoff        Float?    // the officially published passing/cutoff mark, if known — informational, doesn't replace per-record isPassing
  notes             String?
  createdAt         DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  records    ExternalExamRecord[]

  @@unique([schoolId, gradeLevelId, academicYear])
  @@map("external_exam_checkpoints")
}

model ExternalExamRecord {
  id                 String   @id @default(uuid())
  checkpointId       String
  studentProfileId   String
  registrationNumber String?
  examCenter         String?
  status             ExternalExamRegistrationStatus @default(NOT_REGISTERED)
  score              Float?
  grade              String?    // for bodies that issue a band/letter rather than a raw score
  isPassing          Boolean?
  resultDocumentUrl  String?    // uploaded scan of the official result slip/certificate
  resultPublishedAt  DateTime?
  recordedById       String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  checkpoint     ExternalExamCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  recordedBy     User?                  @relation("ExternalExamRecorder", fields: [recordedById], references: [id])

  @@unique([checkpointId, studentProfileId])
  @@index([checkpointId, status])
  @@map("external_exam_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADUATION & COMPLETION CEREMONIES
// ─────────────────────────────────────────────────────────────────────────────

model CeremonyEvent {
  id           String       @id @default(uuid())
  schoolId     String
  gradeLevelId String?      // the milestone grade level this ceremony celebrates (e.g. final KG year); optional for a whole-school event
  type         CeremonyType @default(GRADUATION)
  academicYear String
  title        String       // e.g. "Kindergarten Graduation 2026"
  ceremonyDate DateTime?
  venue        String?
  attireNote   String?      // e.g. "Cap and gown, provided by school"
  program      String?      // free-text agenda/order of program
  createdAt    DateTime     @default(now())

  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel?           @relation(fields: [gradeLevelId], references: [id])
  participants CeremonyParticipant[]

  @@map("ceremony_events")
}

model CeremonyParticipant {
  id                  String   @id @default(uuid())
  ceremonyEventId     String
  studentProfileId    String
  certificateId       String?  // linked once a GRADUATION certificate is issued for this participant
  attendanceConfirmed Boolean  @default(false)
  createdAt           DateTime @default(now())

  ceremonyEvent  CeremonyEvent  @relation(fields: [ceremonyEventId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  certificate    Certificate?   @relation(fields: [certificateId], references: [id])

  @@unique([ceremonyEventId, studentProfileId])
  @@map("ceremony_participants")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR & RECRUITING MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id                String         @id @default(uuid())
  schoolId          String
  userId            String?        @unique
  employeeNumber    String         // e.g. EMP-2026-001
  firstName         String
  middleName        String?
  lastName          String
  email             String?
  phone             String?
  gender            Gender?
  dateOfBirth       DateTime?
  nationalId        String?
  hireDate          DateTime       @default(now())
  employmentType    EmploymentType @default(FULL_TIME)
  status            EmployeeStatus @default(ACTIVE)

  departmentId      String?
  positionId        String?
  managerId         String?

  salary            Float?
  contractStart     DateTime?
  contractEnd       DateTime?
  probationEnd      DateTime?

  address           String?
  city              String?
  emergencyContact  String?
  emergencyPhone    String?
  bankName          String?
  bankAccountNumber String?
  notes             String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  school            School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        LookupValue?   @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position          LookupValue?   @relation("EmployeePosition", fields: [positionId], references: [id])
  manager           Employee?      @relation("EmployeeReportingLine", fields: [managerId], references: [id])
  directReports     Employee[]     @relation("EmployeeReportingLine")

  documents         EmployeeDocument[]
  onboardingChecklists OnboardingChecklist[]
  disciplinaryRecords  StaffDisciplinaryRecord[]
  performanceReviews   PerformanceReview[] @relation("EmployeePerformanceReviews")
  trainingRecords      StaffTraining[]
  offboardingRecords   OffboardingRecord[]
  leaveRequests        LeaveRequest[]
  payrollRecords       PayrollRecord[]

  hiredFromApplications JobApplication[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId, status])
  @@index([schoolId, departmentId])
  @@index([schoolId, positionId])
  @@map("employees")
}

model JobRequisition {
  id                String            @id @default(uuid())
  schoolId          String
  requisitionNumber String            // e.g. REQ-2026-01
  title             String
  departmentId      String?
  positionId        String?
  vacanciesCount    Int               @default(1)
  employmentType    EmploymentType    @default(FULL_TIME)
  reason            String?           // REPLACEMENT | EXPANSION | NEW_SECTION
  salaryMin         Float?
  salaryMax         Float?
  description       String?
  justification     String?
  status            RequisitionStatus @default(DRAFT)
  requestedById     String?
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  targetStartDate   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department        LookupValue?      @relation("RequisitionDepartment", fields: [departmentId], references: [id])
  position          LookupValue?      @relation("RequisitionPosition", fields: [positionId], references: [id])
  requestedBy       User?             @relation("RequisitionRequester", fields: [requestedById], references: [id])
  approvedBy        User?             @relation("RequisitionApprover", fields: [approvedById], references: [id])

  postings          JobPosting[]

  @@unique([schoolId, requisitionNumber])
  @@index([schoolId, status])
  @@map("job_requisitions")
}

model JobPosting {
  id                String            @id @default(uuid())
  schoolId          String
  requisitionId     String?
  title             String
  slug              String
  departmentId      String?
  positionId        String?
  employmentType    EmploymentType    @default(FULL_TIME)
  location          String?           // Campus / Location
  description       String
  requirements      String?
  benefits          String?
  salaryRange       String?
  closingDate       DateTime?
  status            PostingStatus     @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requisition       JobRequisition?   @relation(fields: [requisitionId], references: [id])
  department        LookupValue?      @relation("PostingDepartment", fields: [departmentId], references: [id])
  position          LookupValue?      @relation("PostingPosition", fields: [positionId], references: [id])

  applications      JobApplication[]

  @@unique([schoolId, slug])
  @@index([schoolId, status])
  @@map("job_postings")
}

model JobApplication {
  id                String            @id @default(uuid())
  schoolId          String
  postingId         String
  candidateName     String
  email             String
  phone             String?
  resumeUrl         String?
  coverLetter       String?
  portfolioUrl      String?
  experienceYears   Float?
  currentEmployer   String?
  highestEducation  String?
  stage             ApplicationStage  @default(APPLIED)
  rating            Float?            // 1 to 5 stars
  rejectionReason   String?
  notes             String?
  hiredEmployeeId   String?
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  posting           JobPosting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  hiredEmployee     Employee?         @relation(fields: [hiredEmployeeId], references: [id])

  interviews        JobInterview[]
  offers            JobOffer[]

  @@index([schoolId, stage])
  @@index([postingId, stage])
  @@map("job_applications")
}

model JobInterview {
  id                String            @id @default(uuid())
  schoolId          String
  applicationId     String
  title             String            // e.g. "Round 1 Interview"
  scheduledAt       DateTime
  durationMinutes   Int               @default(45)
  format            InterviewFormat   @default(IN_PERSON)
  locationOrLink    String?           // Room or meeting URL
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application       JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewers      User[]            @relation("InterviewInterviewer")
  feedbacks         InterviewFeedback[]

  @@index([applicationId])
  @@map("job_interviews")
}

model InterviewFeedback {
  id                String                  @id @default(uuid())
  interviewId       String
  interviewerId     String
  score             Float                   // Overall 1 to 5
  recommendation    InterviewRecommendation @default(HOLD)
  criteriaScores    Json?
  strengths         String?
  concerns          String?
  notes             String?
  createdAt         DateTime                @default(now())

  interview         JobInterview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer       User                    @relation("FeedbackInterviewer", fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@map("interview_feedbacks")
}

model JobOffer {
  id                String            @id @default(uuid())
  schoolId          String
  applicationId     String
  offerNumber       String            // e.g. OFR-2026-001
  positionTitle     String
  departmentName    String?
  employmentType    EmploymentType    @default(FULL_TIME)
  offeredSalary     Float
  salaryPeriod      String            @default("MONTHLY") // MONTHLY | ANNUAL
  startDate         DateTime
  probationMonths   Int               @default(3)
  benefits          String?
  conditions        String?
  status            OfferStatus       @default(DRAFT)
  sentAt            DateTime?
  expiresAt         DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  signedLetterUrl   String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application       JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, offerNumber])
  @@map("job_offers")
}

model OnboardingChecklist {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  title             String            // e.g. "New Employee Onboarding"
  status            OnboardingStatus  @default(IN_PROGRESS)
  dueDate           DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items             OnboardingItem[]

  @@map("onboarding_checklists")
}

model OnboardingItem {
  id                String               @id @default(uuid())
  checklistId       String
  title             String
  description       String?
  category          String?              // DOCUMENTATION | IT_SETUP | ORIENTATION | LOGISTICS
  status            OnboardingItemStatus @default(PENDING)
  isRequired        Boolean              @default(true)
  completedAt       DateTime?
  completedById     String?
  notes             String?

  checklist         OnboardingChecklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("onboarding_items")
}

model EmployeeDocument {
  id                String               @id @default(uuid())
  schoolId          String
  employeeId        String
  type              EmployeeDocumentType @default(OTHER)
  title             String
  documentNumber    String?
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  issueDate         DateTime?
  expiryDate        DateTime?
  reminderDays      Int                  @default(30)
  isVerified        Boolean              @default(false)
  verifiedById      String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, expiryDate])
  @@index([employeeId, type])
  @@map("employee_documents")
}

model PerformanceReview {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  reviewerId        String
  cycleName         String            // e.g. "Annual Review 2025/2026"
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime
  selfReviewNotes   String?
  reviewerNotes     String?
  competencyScores  Json?
  overallRating     Float?            // 1 to 5
  goalsSet          String?
  developmentPlan   String?
  status            String            @default("DRAFT") // DRAFT | SUBMITTED | COMPLETED
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation("EmployeePerformanceReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer          User              @relation("PerformanceReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId])
  @@map("performance_reviews")
}

model StaffTraining {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  title             String
  provider          String?
  category          String?           // PEDAGOGY | LEADERSHIP | TECH | SAFETY | SPECIAL_ED
  hoursCompleted    Float?
  startDate         DateTime?
  completionDate    DateTime
  expiryDate        DateTime?
  certificateUrl    String?
  notes             String?
  createdAt         DateTime          @default(now())

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("staff_trainings")
}

model StaffDisciplinaryRecord {
  id                String                @id @default(uuid())
  schoolId          String
  employeeId        String
  type              StaffDisciplinaryType @default(WRITTEN_WARNING)
  incidentDate      DateTime              @default(now())
  title             String
  description       String
  actionTaken       String?
  isResolved        Boolean               @default(false)
  resolvedAt        DateTime?
  resolutionNotes   String?
  recordedById      String?
  documentUrl       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("staff_disciplinary_records")
}

model OffboardingRecord {
  id                String            @id @default(uuid())
  schoolId          String
  employeeId        String
  type              String            // RESIGNATION | TERMINATION | RETIREMENT | END_OF_CONTRACT
  reason            String?
  noticeDate        DateTime?
  lastWorkingDay    DateTime
  exitInterviewNotes String?
  finalSettlementNotes String?
  status            OffboardingStatus @default(INITIATED)
  completedAt       DateTime?
  userDeactivated   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklistItems    ExitChecklistItem[]

  @@map("offboarding_records")
}

model ExitChecklistItem {
  id                String            @id @default(uuid())
  offboardingId     String
  title             String            // e.g. "Laptop Return", "Revoke Email Access"
  category          String?           // ASSETS | IT_ACCESS | FINANCE | HR
  isCompleted       Boolean           @default(false)
  completedAt       DateTime?
  completedBy       String?
  notes             String?

  offboarding       OffboardingRecord @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@map("exit_checklist_items")
}

